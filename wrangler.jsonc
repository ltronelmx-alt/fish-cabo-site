{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fish-cabo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Free plan: only pages and /api go through the Worker (staging lock, redirects, www → apex, forms).
    // Images, fonts, scripts and styles are served directly as static assets: free, unlimited, never counted
    // in the 100,000 requests/day Worker limit.
    "run_worker_first": ["/*", "!/media/*", "!/_astro/*", "!/fonts/*", "!/og/*", "!/js/*", "!/cms/*", "!/favicon.ico"]
  },
  "observability": { "enabled": true },
  // Booking system: Cloudflare D1 (free plan: 5 GB, 5M reads + 100k writes per day). Wrangler creates the database
  // automatically on the first deploy (no database_id needed). Tables are created by the Worker itself (worker/booking/schema.ts).
  "d1_databases": [{ "binding": "DB", "database_name": "fish-cabo-bookings" }],
  // Hourly: release expired holds, Wise expiry notices, retry confirmation emails that failed (free plan: 5 cron triggers).
  "triggers": { "crons": ["17 * * * *"] },
  // Enable after creating the dataset (free): uncomment to store click counts.
  // "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "fishcabo_events" }],
  // Production configuration. Staging isolation does not depend on this value: on *.workers.dev the Worker
  // always adds X-Robots-Tag noindex, serves robots.txt "Disallow: /" and applies the STAGING_PASSWORD lock.
  "vars": { "SITE_ENV": "production" }
}
