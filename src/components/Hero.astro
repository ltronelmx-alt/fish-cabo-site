---
import Img from './Img.astro';
interface Props {
  image: { src: string; alt: string; width?: number; height?: number };
  variant?: 'home' | 'page';
  position?: string; // object-position of the photo
}
const { image, variant = 'page', position = 'center' } = Astro.props;
---
<section class:list={['hero', 'dark', `hero-${variant}`]}>
  <Img src={image.src} alt={image.alt} sizes="100vw" priority class="hero-img" />
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="container hero-inner">
    <slot />
  </div>
</section>
<style define:vars={{ pos: position }}>
  /* Whole photo, never cropped: the image keeps its own proportions; text sits on it (desktop) or under it (mobile). */
  .hero { position: relative; isolation: isolate; overflow: hidden; display: grid; grid-template: 1fr / 1fr; background: var(--ink); color: #e9e9e9; }
  .hero > :global(picture), .hero > :global(img), .hero-shade, .hero-inner { grid-area: 1 / 1; }
  .hero > :global(picture) { display: block; z-index: -2; }
  .hero :global(.hero-img) { display: block; width: 100%; height: auto; max-height: 100svh; object-fit: contain; margin-inline: auto; }
  .hero-shade { position: relative; z-index: -1; background:
      linear-gradient(to top, rgb(0 0 0 / 0.82) 0%, rgb(0 0 0 / 0.35) 45%, rgb(0 0 0 / 0.1) 70%, rgb(0 0 0 / 0.35) 100%),
      linear-gradient(to right, rgb(0 0 0 / 0.45), transparent 60%); }
  .hero-inner { align-self: end; padding-top: 140px; padding-bottom: clamp(40px, 5vw, 72px); }
  @media (max-width: 760px) {
    .hero { grid-template: auto auto / 1fr; }
    .hero > :global(picture), .hero > :global(img) { grid-row: 1; }
    .hero-shade { grid-row: 1; background: linear-gradient(to bottom, rgb(0 0 0 / 0.55), transparent 35%); }
    .hero-inner { grid-row: 2; padding-top: 32px; }
  }
  .hero :global(h1) { color: var(--white); max-width: 22ch; margin-bottom: 0.35em; }
  .hero-page :global(h1) { max-width: 18ch; font-size: clamp(36px, 3.6vw + 14px, 76px); }
  .hero :global(.lead) { max-width: 640px; color: #ececec; margin-bottom: 0; }
  .hero :global(.facts) { margin-top: clamp(40px, 5vw, 72px); }
  @media (prefers-reduced-motion: no-preference) {
    .hero :global(.hero-img) { animation: heroZoom 14s var(--ease) both; }
    .hero-inner > :global(*) { animation: heroIn 0.9s var(--ease) both; }
    .hero-inner > :global(*:nth-child(2)) { animation-delay: 0.08s; }
    .hero-inner > :global(*:nth-child(3)) { animation-delay: 0.16s; }
    .hero-inner > :global(*:nth-child(4)) { animation-delay: 0.24s; }
    .hero-inner > :global(*:nth-child(5)) { animation-delay: 0.32s; }
    @keyframes heroZoom { from { opacity: 0.6; } to { opacity: 1; } }
    @keyframes heroIn { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  }
</style>
