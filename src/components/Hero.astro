---
import Img from './Img.astro';
interface Props {
  image: { src: string; alt: string; width: number; height: number };
  variant: 'home' | 'short' | 'tall';
  align?: 'start' | 'center';
  tone?: 'white' | 'gray';
  overlay?: number; // 0–1, darkening for legibility
  bg?: string;
}
const { image, variant, align = 'start', tone = 'white', overlay = 0, bg = '#000' } = Astro.props;
---
<section class:list={['hero', `hero-${variant}`, `align-${align}`, `tone-${tone}`]} style={`--ov:${overlay};background:${bg}`}>
  <Img {...image} sizes="100vw" priority class="hero-img" />
  <div class="hero-content"><slot /></div>
</section>
<style>
  .hero { position: relative; display: flex; overflow: hidden; isolation: isolate; padding: 74px var(--gutter) 0; }
  .hero :global(.hero-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: rgb(0 0 0 / var(--ov)); }
  .hero-content { width: 100%; }
  .tone-white { color: var(--white); }
  .tone-gray { color: var(--gray); }
  .align-center { text-align: center; }
  .hero :global(h1) { margin: 0; }

  /* Home: tall image hero, headline lower third, intro under it */
  .hero-home { min-height: max(574px, 76.3vw); align-items: flex-end; padding-bottom: 5.5vw; }
  .hero-home .hero-content { padding-inline: 0; }
  .hero-home :global(p) { font-size: var(--fs-p-lg); margin: 4.6vw 0 0; padding-inline: 1vw; max-width: 92vw; }
  .hero-home :global(h1) { margin-left: -1vw; }

  /* Fishing Charters: short banner */
  .hero-short { min-height: max(260px, 21vw); align-items: center; }
  /* Fishing Boats: medium banner */
  .hero-tall { min-height: max(380px, 42.4vw); align-items: center; }

  @media (max-width: 767px) {
    .hero-home { padding-bottom: 28px; min-height: 574px; }
    .hero-home :global(p) { margin-top: 24px; padding-inline: 10px; }
    .hero-home :global(h1) { margin-left: -12px; }
  }
</style>
