---
// Homepage top section: design approved by the owner on 2026-11-15 (prototype artifact v15).
// H1 text is the original one (src/data/original/home.json). Links/labels = live site (NAV, SITE).
import { SITE } from '../data/site';
import '../styles/efd-home.css';
---
<div class="efd">
<main>
  <!-- ============ HERO ============ -->
  <section class="efd-sec efd-hero" aria-labelledby="efd-h1">
    <picture class="efd-bg">
      <source media="(max-width: 860px)" srcset="/media/efd/hero-m-1200.webp" width="1200" height="583">
      <img src="/media/efd/hero-2400.webp" srcset="/media/efd/hero-1400.webp 1400w, /media/efd/hero-2400.webp 2400w" sizes="100vw" width="2400" height="1391" fetchpriority="high"
           alt="Exotic Fish Cabo angler fighting a jumping blue marlin off San José del Cabo">
    </picture>

    <a class="efd-logo-hit" href="/"><span class="efd-sr">Exotic Fish Cabo — Home</span></a>

    <nav class="efd-nav" aria-label="Main">
      <ul>
        <li class="efd-dd" id="efd-dd">
          <button class="efd-dd-btn" type="button" aria-expanded="false" aria-controls="efd-dd-panel">Explore Fishing
            <svg class="efd-caret" viewBox="0 0 10 10" aria-hidden="true"><path d="M1.5 3.2 5 6.8l3.5-3.6" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></button>
          <ul class="efd-dd-panel" id="efd-dd-panel">
            <li><a href="/fishing-calendar">Fishing Calendar</a></li>
            <li><a href="/fishing-reports">Fishing Reports</a></li>
            <li><a href="/family-fishing-charters-san-jose-del-cabo">Family Charters</a></li>
            <li><a href="/what-to-bring-fishing-cabo">What to Bring</a></li>
            <li><a href="/fish-species">Fish Species</a></li>
            <li><a href="/cabo-fishing-tournaments">Tournaments</a></li>
            <li><a href="/fishing-guide-for-newbies">Free guide</a></li>
            <li><a href="/cabo-fishing-videos">Videos</a></li>
            <li><a href="/cabo-fishing-faq">FAQ's</a></li>
          </ul>
        </li>
        <li><a class="efd-nav-link" href="/" aria-current="page">Cabo Fishing</a></li>
        <li><a class="efd-nav-link" href="/fishing-charters">Fishing Charters</a></li>
        <li><a class="efd-nav-link" href="/fishing-boats">Fishing Boats</a></li>
        <li><a class="efd-nav-link" href="/contact">Contact</a></li>
      </ul>
      <a class="efd-btn efd-btn-ghost" href={SITE.gpsUrl} target="_blank" rel="noopener" data-track="marina_gps"><span>Marina GPS</span></a>
      <a class="efd-btn efd-btn-orange" href={SITE.bookUrl} data-track="book_now_header"><span style="display:inline-flex;align-items:center;gap:.45em"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7 2h2v2h6V2h2v2h3a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3V2zm12 8H5v9h14v-9zM5 6v2h14V6H5zm2 6h3v3H7v-3z"/></svg>Book Now</span></a>
    </nav>

    <button class="efd-burger" type="button" aria-expanded="false" aria-controls="efd-mmenu" aria-label="Open menu"><span></span></button>
    <div class="efd-mmenu" id="efd-mmenu" hidden data-lenis-prevent>
      <details><summary>Explore Fishing ▾</summary>
        <a href="/fishing-calendar">Fishing Calendar</a><a href="/fishing-reports">Fishing Reports</a>
        <a href="/family-fishing-charters-san-jose-del-cabo">Family Charters</a><a href="/what-to-bring-fishing-cabo">What to Bring</a>
        <a href="/fish-species">Fish Species</a><a href="/cabo-fishing-tournaments">Tournaments</a>
        <a href="/fishing-guide-for-newbies">Free guide</a><a href="/cabo-fishing-videos">Videos</a><a href="/cabo-fishing-faq">FAQ's</a>
      </details>
      <a href="/" aria-current="page">Cabo Fishing</a>
      <a href="/fishing-charters">Fishing Charters</a>
      <a href="/fishing-boats">Fishing Boats</a>
      <a href="/contact">Contact</a>
      <a class="efd-btn efd-btn-ghost" href={SITE.gpsUrl} target="_blank" rel="noopener" data-track="marina_gps"><span>Marina GPS</span></a>
      <a class="efd-btn efd-btn-orange" href={SITE.bookUrl} data-track="book_now_header"><span>Book Now</span></a>
    </div>

    <p class="efd-kicker">San José del Cabo <span class="efd-dot">•</span> Mexico</p>
    <p class="efd-sr efd-brand-sr">Exotic Fish Cabo</p>
    <h1 id="efd-h1">Cabo Fishing Charters <span class="efd-l2">– Departing from San José del Cabo</span></h1>
    <img class="efd-swoosh" src="/media/efd/swoosh.png" width="580" height="102" alt="">

    <ul class="efd-badges">
      <li><img src="/media/efd/i-boat.png" width="150" height="54" alt="">10 Selected Boats<br>(23′ – 44′)</li>
      <li><img src="/media/efd/i-fish.png" width="140" height="49" alt="">World-Class<br>Fishing</li>
      <li><img src="/media/efd/i-hat.png" width="110" height="66" alt="">Experienced<br>Captains</li>
      <li class="efd-laurel"><img src="/media/efd/i-laurel.png" width="170" height="122" alt="12+ years in Cabo"></li>
