---
// Homepage top section: design approved by the owner on 2026-11-15 (prototype artifact v15).
// H1 text is the original one (src/data/original/home.json). Links/labels = live site (NAV, SITE).
import { SITE } from '../data/site';
import '../styles/efd-home.css';
// Carousel cards (≤860px) reuse each desktop panel exactly: same photo position, label, strokes and frame.
const FISH0 = [
  { name: 'Marlin', href: '/marlin-fishing-cabo', photo: '/media/efd/marlin-photo.webp', px: -150, py: -58, pw: 1695, ph: 961, label: '/media/efd/marlin-label.png', lx: 420, lw: 440, pts: '364,20 1255,20 991,740 100,740', vb: 90, vw: 1175 },
  { name: 'Tuna', href: '/tuna-fishing-cabo', photo: '/media/efd/tuna-photo.webp', px: 958, py: -152, pw: 1308, ph: 894, label: '/media/efd/tuna-label.png', lx: 1340, lw: 320, pts: '1255,20 2164,20 1891,740 991,740', vb: 981, vw: 1193 },
  { name: 'Dorado', href: '/dorado-fishing-cabo', photo: '/media/efd/dorado-photo.webp', px: 1860, py: 5, pw: 1170, ph: 780, label: '/media/efd/dorado-label.png', lx: 2150, lw: 440, pts: '2164,20 2990,20 2718,740 1891,740', vb: 1881, vw: 1119 },
  { name: 'Wahoo', href: '/wahoo-fishing-cabo', photo: '/media/efd/wahoo-photo.webp', px: 2712, py: 10, pw: 1183, ph: 780, label: '/media/efd/wahoo-label.png', lx: 3060, lw: 380, pts: '2990,20 3891,20 3627,740 2718,740', vb: 2708, vw: 1193 },
  { name: 'Roosterfish', href: '/roosterfish-fishing-cabo', photo: '/media/efd/rooster-photo.webp', px: 3523, py: -126, pw: 1330, ph: 912, label: '/media/efd/rooster-label.png', lx: 3870, lw: 650, pts: '3891,20 4790,20 4526,740 3627,740', vb: 3617, vw: 1179 },
];
// band under each card for its orange stroke: continues the panel's slant 60 units below the frame
const FISH = FISH0.map((f) => { const p = f.pts.split(' ').map((q) => q.split(',').map(Number)); const k = (p[0][0] - p[3][0]) / 720; const [bl, br] = [p[3][0], p[2][0]]; return { ...f, band: `${bl},728 ${br},728 ${br - k * 72},800 ${bl - k * 72},800` }; });
---
<div class="efd">
<main>
  <!-- ============ HERO ============ -->
  <section class="efd-sec efd-hero" aria-labelledby="efd-h1">
    <!-- Hero photo: the owner's original file, served byte for byte (no resize, no re-encode). Title, darkening and
         brush strokes are a separate transparent layer that is fully transparent over the marlin. -->
    <div class="efd-stage">
      <div class="efd-stage-in">
        <picture>
          <!-- phones (≤560px): the owner's lighter copy of the same photo (1200×849, same framing), served byte for byte -->
          <source media="(max-width: 560px)" srcset="/media/efd/hero-marlin-mobile.webp" width="1200" height="849">
          <img class="efd-photo" src="/media/efd/hero-marlin-original.webp" width="1491" height="1055" fetchpriority="high"
               alt="Exotic Fish Cabo angler fighting a jumping blue marlin off San José del Cabo">
        </picture>
        <img class="efd-decor" src="/media/efd/hero-decor-2400.webp" srcset="/media/efd/hero-decor-1200.webp 1200w, /media/efd/hero-decor-2400.webp 2400w" sizes="100vw" width="2398" height="1390" alt="">
        <img class="efd-hero-logo" src="/media/efd/logo-exotic.webp" width="1280" height="1016" loading="lazy" alt="">
      </div>
    </div>

    <a class="efd-logo-hit" href="/"><span class="efd-sr">Exotic Fish Cabo — Home</span></a>



    <p class="efd-kicker">San José del Cabo <span class="efd-dot">•</span> Mexico</p>
    <p class="efd-sr efd-brand-sr">Exotic Fish Cabo</p>
    <h1 id="efd-h1">Cabo Fishing Charters <span class="efd-l2">– Departing from San José del Cabo</span></h1>
    <img class="efd-swoosh" src="/media/efd/swoosh.png" width="580" height="102" alt="">

    <ul class="efd-badges">
      <li><img src="/media/efd/i-boat.png" width="150" height="54" alt="">10 Selected Boats<br>(23′ – 44′)</li>
      <li><img src="/media/efd/i-fish.png" width="140" height="49" alt="">World-Class<br>Fishing</li>
      <li><img src="/media/efd/i-hat.png" width="110" height="66" alt="">Experienced<br>Captains</li>
      <li class="efd-laurel"><span class="efd-since"><img src="/media/efd/i-laurel-white.png" width="405" height="289" alt=""><span class="efd-since-t"><span class="efd-since-a">SINCE</span> <span class="efd-since-b">2014</span></span></span></li>
    </ul>

    <div class="efc-cue efd-cue" aria-hidden="true"></div>

    <a class="efd-btn efd-btn-orange efd-btn-big" href={SITE.bookUrl} data-track="book_now_hero"><span style="display:inline-flex;align-items:center;gap:.45em"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7 2h2v2h6V2h2v2h3a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3V2zm12 8H5v9h14v-9zM5 6v2h14V6H5zm2 6h3v3H7v-3z"/></svg>Book Now<span class="efd-arr" aria-hidden="true">»</span></span></a>
  </section>

  <!-- ============ SPECIES STRIP ============ -->
  <section class="efd-sec efd-species" aria-label="Fish species">
    <div class="efd-strip-wrap">
      <svg class="efd-strip" viewBox="0 0 4796 840" role="list" aria-label="Fish species in Cabo">
        <defs>
          <linearGradient id="efd-sh" x1="0" x2="1"><stop offset="0" stop-color="#fff" stop-opacity="0"/><stop offset=".5" stop-color="#fff" stop-opacity=".28"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient>
          <linearGradient id="efd-fade" x1="0" y1="20" x2="0" y2="740" gradientUnits="userSpaceOnUse"><stop offset=".55" stop-color="#05070b" stop-opacity="0"/><stop offset=".95" stop-color="#05070b" stop-opacity=".75"/></linearGradient>
          <clipPath id="efd-c1"><polygon points="364,20 1255,20 991,740 100,740"/></clipPath>
          <clipPath id="efd-c2"><polygon points="1255,20 2164,20 1891,740 991,740"/></clipPath>
          <clipPath id="efd-c3"><polygon points="2164,20 2990,20 2718,740 1891,740"/></clipPath>
          <clipPath id="efd-c4"><polygon points="2990,20 3891,20 3627,740 2718,740"/></clipPath>
          <clipPath id="efd-c5"><polygon points="3891,20 4812,20 4676,740 3627,740"/></clipPath>
        </defs>
        <image href="/media/efd/strip-2400.webp" width="4796" height="840" preserveAspectRatio="none"/>
        <g clip-path="url(#efd-c1)">
          <image href="/media/efd/marlin-photo.webp" x="-150" y="-58" width="1695" height="961" preserveAspectRatio="xMidYMid meet"/>
          <polygon points="364,20 1255,20 991,740 100,740" fill="url(#efd-fade)"/>
        </g>
        <image href="/media/efd/marlin-label.png" x="420" y="580" width="440" height="150" preserveAspectRatio="none"/>
        <g clip-path="url(#efd-c2)">
          <image href="/media/efd/tuna-photo.webp" x="958" y="-152" width="1308" height="894" preserveAspectRatio="xMidYMid meet"/>
          <polygon points="1255,20 2164,20 1891,740 991,740" fill="url(#efd-fade)"/>
        </g>
        <image href="/media/efd/tuna-label.png" x="1340" y="580" width="320" height="150" preserveAspectRatio="none"/>
        <g clip-path="url(#efd-c3)">
          <image href="/media/efd/dorado-photo.webp" x="1860" y="5" width="1170" height="780" preserveAspectRatio="xMidYMid meet"/>
          <polygon points="2164,20 2990,20 2718,740 1891,740" fill="url(#efd-fade)"/>
        </g>
        <image href="/media/efd/dorado-label.png" x="2150" y="580" width="440" height="150" preserveAspectRatio="none"/>
        <g clip-path="url(#efd-c4)">
          <image href="/media/efd/wahoo-photo.webp" x="2712" y="10" width="1183" height="780" preserveAspectRatio="xMidYMid meet"/>
          <polygon points="2990,20 3891,20 3627,740 2718,740" fill="url(#efd-fade)"/>
        </g>
        <image href="/media/efd/wahoo-label.png" x="3060" y="580" width="380" height="150" preserveAspectRatio="none"/>
        <g clip-path="url(#efd-c5)">
          <image href="/media/efd/rooster-photo.webp" x="3523" y="-126" width="1330" height="912" preserveAspectRatio="xMidYMid meet"/>
          <polygon points="3891,20 4812,20 4676,740 3627,740" fill="url(#efd-fade)"/>
        </g>
        <image href="/media/efd/rooster-label.png" x="3870" y="580" width="650" height="150" preserveAspectRatio="none"/>
        <g stroke="#05070b" stroke-width="26" stroke-linecap="square" aria-hidden="true"><line x1="1255" y1="14" x2="991" y2="746"/><line x1="2164" y1="14" x2="1891" y2="746"/><line x1="2990" y1="14" x2="2718" y2="746"/><line x1="3891" y1="14" x2="3627" y2="746"/></g>
        <g fill="none" stroke="#fb7704" stroke-width="20" pointer-events="none" aria-hidden="true"><polygon clip-path="url(#efd-c1)" points="364,20 1255,20 991,740 100,740"/><polygon clip-path="url(#efd-c2)" points="1255,20 2164,20 1891,740 991,740"/><polygon clip-path="url(#efd-c3)" points="2164,20 2990,20 2718,740 1891,740"/><polygon clip-path="url(#efd-c4)" points="2990,20 3891,20 3627,740 2718,740"/><polygon clip-path="url(#efd-c5)" points="3891,20 4812,20 4676,740 3627,740"/></g>
        <image href="/media/efd/strip-strokes.png" width="4796" height="840" preserveAspectRatio="none" pointer-events="none" aria-hidden="true"/>
        <a class="efd-fish" href="/marlin-fishing-cabo" role="listitem" aria-label="Marlin fishing"><g clip-path="url(#efd-c1)"><polygon class="efd-shade" points="364,20 1255,20 991,740 100,740"/><rect class="efd-sheen" x="500" y="0" width="420" height="840" fill="url(#efd-sh)"/></g><polygon class="efd-edge" points="364,20 1255,20 991,740 100,740"/></a>
        <a class="efd-fish" href="/tuna-fishing-cabo" role="listitem" aria-label="Tuna fishing"><g clip-path="url(#efd-c2)"><polygon class="efd-shade" points="1255,20 2164,20 1891,740 991,740"/><rect class="efd-sheen" x="1400" y="0" width="420" height="840" fill="url(#efd-sh)"/></g><polygon class="efd-edge" points="1255,20 2164,20 1891,740 991,740"/></a>
        <a class="efd-fish" href="/dorado-fishing-cabo" role="listitem" aria-label="Dorado fishing"><g clip-path="url(#efd-c3)"><polygon class="efd-shade" points="2164,20 2990,20 2718,740 1891,740"/><rect class="efd-sheen" x="2230" y="0" width="420" height="840" fill="url(#efd-sh)"/></g><polygon class="efd-edge" points="2164,20 2990,20 2718,740 1891,740"/></a>
        <a class="efd-fish" href="/wahoo-fishing-cabo" role="listitem" aria-label="Wahoo fishing"><g clip-path="url(#efd-c4)"><polygon class="efd-shade" points="2990,20 3891,20 3627,740 2718,740"/><rect class="efd-sheen" x="3100" y="0" width="420" height="840" fill="url(#efd-sh)"/></g><polygon class="efd-edge" points="2990,20 3891,20 3627,740 2718,740"/></a>
        <a class="efd-fish" href="/roosterfish-fishing-cabo" role="listitem" aria-label="Roosterfish fishing"><g clip-path="url(#efd-c5)"><polygon class="efd-shade" points="3891,20 4812,20 4676,740 3627,740"/><rect class="efd-sheen" x="4000" y="0" width="420" height="840" fill="url(#efd-sh)"/></g><polygon class="efd-edge" points="3891,20 4812,20 4676,740 3627,740"/></a>
      </svg>
    </div>
    <p class="efd-swipe" aria-hidden="true"><b>‹</b> Swipe <b>›</b></p>

    <!-- phones & tablets (≤860px): the same five panels, one at a time -->
    <div class="efd-car" data-lenis-prevent-horizontal>
      <ul class="efd-car-track" id="efd-car-track" aria-label="Fish species in Cabo">
        {FISH.map((f, i) => (
          <li class="efd-card">
            <a href={f.href} aria-label={`${f.name} fishing`}>
              <svg viewBox={`${f.vb} 0 ${f.vw} 800`} role="img" aria-hidden="true" focusable="false">
                <defs>
                  <clipPath id={`efd-k${i}`}><polygon points={f.pts} /></clipPath>
                  <clipPath id={`efd-kb${i}`}><polygon points={f.band} /></clipPath>
                  <linearGradient id={`efd-kf${i}`} x1="0" y1="20" x2="0" y2="740" gradientUnits="userSpaceOnUse"><stop offset=".45" stop-color="#05070b" stop-opacity="0" /><stop offset=".97" stop-color="#05070b" stop-opacity=".85" /></linearGradient>
                </defs>
                <g clip-path={`url(#efd-k${i})`}>
                  <image href="/media/efd/strip-2400.webp" width="4796" height="840" preserveAspectRatio="none" />
                  <image href={f.photo} x={f.px} y={f.py} width={f.pw} height={f.ph} preserveAspectRatio="xMidYMid meet" />
                  <polygon points={f.pts} fill={`url(#efd-kf${i})`} />
                  <image href="/media/efd/strip-strokes.png" width="4796" height="840" preserveAspectRatio="none" />
                </g>
                <g clip-path={`url(#efd-kb${i})`}><image href="/media/efd/strip-2400.webp" width="4796" height="840" preserveAspectRatio="none" /><image href="/media/efd/strip-strokes.png" width="4796" height="840" preserveAspectRatio="none" /></g>
                <image href={f.label} x={f.lx} y="580" width={f.lw} height="150" preserveAspectRatio="none" />
                <polygon class="efd-card-edge" points={f.pts} clip-path={`url(#efd-k${i})`} />
              </svg>
            </a>
          </li>
        ))}
      </ul>
      <div class="efd-car-nav">
        <button type="button" class="efd-car-btn" data-dir="-1" aria-controls="efd-car-track" aria-label="Previous fish">‹</button>
        <p class="efd-car-pos" aria-live="polite"><span class="efd-car-i">1</span> / 5</p>
        <button type="button" class="efd-car-btn" data-dir="1" aria-controls="efd-car-track" aria-label="Next fish">›</button>
      </div>
    </div>
  </section>

  <!-- ============ FLEET ============ -->
  <section class="efd-sec efd-fleet" aria-labelledby="efd-fleet-h">
    <picture class="efd-bg">
      <source media="(max-width: 860px)" srcset="/media/efd/fleet-1200.webp">
      <img src="/media/efd/fleet-2400.webp" srcset="/media/efd/fleet-1200.webp 1200w, /media/efd/fleet-2400.webp 2400w" sizes="100vw" width="2400" height="815" loading="lazy" alt="Sportfishing boat running at sunset off Los Cabos">
    </picture>
    <div class="efd-fl-copy">
      <p class="efd-eyebrow">Puerto Los Cabos Marina</p>
      <p class="efd-h2" id="efd-fleet-h"><span class="efd-chrome">Fishing Boats for</span><span class="efd-chrome">Couples, Families,</span><span class="efd-hot">and Groups</span></p>
      <img class="efd-fl-swoosh" src="/media/efd/swoosh.png" width="580" height="102" alt="">
      <p class="efd-fl-p">Choosing the right fishing boat can make a significant difference to your experience. Exotic Fish Cabo offers several boat styles to accommodate different group sizes, fishing preferences, and budgets.</p>
      <a class="efd-btn efd-btn-line" href="/fishing-boats"><span>Explore Our Fishing Boats</span><span class="efd-arr" aria-hidden="true">»</span></a>
    </div>
  </section>
</main>
</div>

<script>
  // Species carousel (≤860px): manual only, endless in both directions (Marlin → … → Roosterfish → Marlin),
  // position indicator, prev/next buttons. The loop uses a copy of the five cards on each side that are made here in the
  // browser (not in the HTML): hidden from screen readers and from the keyboard, and never seen by search engines.
  const track = document.getElementById('efd-car-track');
  const idx = document.querySelector('.efd-car-i');
  if (track && idx) {
    const real = Array.from(track.children) as HTMLElement[];
    const N = real.length;
    const mk = (el: HTMLElement) => { const c = el.cloneNode(true) as HTMLElement; c.setAttribute('aria-hidden', 'true'); c.dataset.clone = '1'; c.querySelectorAll('a').forEach((a) => a.setAttribute('tabindex', '-1')); return c; };
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let all = real.slice(), K = 0;                                  // copies are added after load (keeps the first paint light)
    const centre = (c: HTMLElement) => c.offsetLeft + c.offsetWidth / 2 - track.clientWidth / 2;
    const nearest = () => { const mid = track.scrollLeft + track.clientWidth / 2; let best = 0, d = Infinity; all.forEach((c, i) => { const m = c.offsetLeft + c.offsetWidth / 2; if (Math.abs(m - mid) < d) { d = Math.abs(m - mid); best = i; } }); return best; };
    const realOf = (i: number) => ((i - K) % N + N) % N;
    const jump = (i: number) => { const prev = track.style.scrollSnapType; track.style.scrollSnapType = 'none'; track.scrollLeft = centre(all[i]); track.style.scrollSnapType = prev; };
    const loop = () => {
      if (K) return;
      const keep = realOf(nearest()), max = track.scrollWidth - track.clientWidth, before = track.scrollLeft - Math.max(0, Math.min(max, centre(all[nearest()])));
      real.forEach((el) => track.insertBefore(mk(el), real[0]));   // a copy of the five cards on each side
      real.forEach((el) => track.appendChild(mk(el)));
      K = N; all = Array.from(track.children) as HTMLElement[];
      const prev = track.style.scrollSnapType; track.style.scrollSnapType = 'none'; track.scrollLeft = centre(all[K + keep]) + before; track.style.scrollSnapType = prev;
    };
    // made shortly after the page has loaded (never during a finger movement), or at once if the visitor uses the buttons / keyboard first
    const idle = () => ('requestIdleCallback' in window ? (window as any).requestIdleCallback(loop, { timeout: 1500 }) : setTimeout(loop, 600));
    if (document.readyState === 'complete') idle(); else addEventListener('load', idle, { once: true });
    const settle = () => { const i = nearest(); if (all[i].dataset.clone) jump(K + realOf(i)); idx.textContent = String(realOf(nearest()) + 1); };
    const go = (i: number) => track.scrollTo({ left: centre(all[i]), behavior: reduce ? 'auto' : 'smooth' });
    let t = 0, raf = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(raf); raf = requestAnimationFrame(() => { idx.textContent = String(realOf(nearest()) + 1); });
      clearTimeout(t); t = window.setTimeout(settle, 140);   // fallback where 'scrollend' is not supported
    }, { passive: true });
    track.addEventListener('scrollend', () => { clearTimeout(t); settle(); });
    let rw = 0; addEventListener('resize', () => { cancelAnimationFrame(rw); rw = requestAnimationFrame(() => jump(K + realOf(nearest()))); });
    document.querySelectorAll<HTMLButtonElement>('.efd-car-btn').forEach((b) => b.addEventListener('click', () => {
      loop();
      let i = nearest(); if (all[i].dataset.clone) { jump(K + realOf(i)); i = K + realOf(i); }
      go(i + Number(b.dataset.dir));
    }));
    real.forEach((c, i) => c.querySelector('a')?.addEventListener('focus', () => { loop(); go(K + i); }));
  }
</script>


