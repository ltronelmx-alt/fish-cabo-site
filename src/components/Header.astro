---
// Site header, mobile menu and phone bar — the Exotic Fish Cabo design (owner 2026-11-15), identical on every page.
// Labels and links come from NAV / SITE (unchanged). Desktop above 860px, menu + bottom bar at 860px and below.
import { NAV, SITE } from '../data/site';
import { media } from '../lib/media';
import '../styles/efd-home.css';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '') || '/';
const logo = media(SITE.logo)!;
const cal = 'M7 2h2v2h6V2h2v2h3a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3V2zm12 8H5v9h14v-9zM5 6v2h14V6H5zm2 6h3v3H7v-3z';
const wa = `https://wa.me/${SITE.whatsapp.replace(/\D/g, '')}`;
---
<a class="skip-link" href="#main">Skip to Content</a>
<header class="efd-hdr" id="header">
  <a class="efd-hdr-logo" href="/" aria-label="Exotic Fish Cabo — home">
    <img src={logo.at(216)} alt="EXOTIC FISH CABO" width={logo.width} height={logo.height} />
  </a>
  <nav class="efd-nav" aria-label="Main">
    <ul>
      {NAV.map((item) =>
        item.children ? (
          <li class="efd-dd" id="efd-dd">
            <button class="efd-dd-btn" type="button" aria-expanded="false" aria-controls="efd-dd-panel">{item.label}
              <svg class="efd-caret" viewBox="0 0 10 10" aria-hidden="true"><path d="M1.5 3.2 5 6.8l3.5-3.6" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></button>
            <ul class="efd-dd-panel" id="efd-dd-panel">
              {item.children.map((c) => <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>)}
            </ul>
          </li>
        ) : (
          <li><a class="efd-nav-link" href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a></li>
        )
      )}
    </ul>
    <a class="efd-btn efd-btn-ghost" href={SITE.gpsUrl} target="_blank" rel="noopener" data-track="marina_gps"><span>Marina GPS</span></a>
    <a class="efd-btn efd-btn-orange" href={SITE.bookUrl} data-track="book_now_header"><span class="efd-btn-in"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={cal}/></svg>Book Now</span></a>
  </nav>
  <button class="efd-burger" type="button" aria-expanded="false" aria-controls="efd-mmenu" aria-label="Open menu"><span></span></button>
</header>

<div class="efd-mmenu" id="efd-mmenu" hidden data-lenis-prevent>
  <nav aria-label="Mobile">
    {NAV.map((item) =>
      item.children ? (
        <details>
          <summary>{item.label}<svg class="efd-caret" viewBox="0 0 10 10" aria-hidden="true"><path d="M1.5 3.2 5 6.8l3.5-3.6" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></summary>
          <div class="efd-mm-sub">{item.children.map((c) => <a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a>)}</div>
        </details>
      ) : (
        <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
      )
    )}
  </nav>
  <div class="efd-mm-cta">
    <a class="efd-btn efd-btn-ghost" href={SITE.gpsUrl} target="_blank" rel="noopener" data-track="marina_gps_menu"><span>Marina GPS</span></a>
    <a class="efd-btn efd-btn-orange" href={SITE.bookUrl} data-track="book_now_menu"><span class="efd-btn-in"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={cal}/></svg>Book Now</span></a>
  </div>
</div>

<!-- phone bar (≤860px), same on every page: 25% Marina GPS · 25% WhatsApp (opens the chat assistant) · 50% Book Now -->
<nav class="efd-mbar" aria-label="Quick actions">
  <a class="efd-gps" href={SITE.gpsUrl} target="_blank" rel="noopener" data-track="marina_gps_mobile"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg><span>Marina GPS</span></a>
  <a class="efd-wa" href={wa} target="_blank" rel="noopener" data-efc-chat-open data-track="whatsapp_bar_mobile"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .2A11.8 11.8 0 0 0 1.9 18L.2 24l6.2-1.6A11.8 11.8 0 1 0 12 .2zm0 21.6c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.8 9.8 0 1 1 12 21.8z"/></svg><span>WhatsApp</span></a>
  <a class="efd-book" href={SITE.bookUrl} data-track="book_now_mobile">Book Now</a>
</nav>

<style is:global>
  /* header box: same coordinates as the homepage design (mockup units: --efd-u = header width / 4796) */
  .efd-hdr { position: fixed; z-index: 50; top: 0; left: 0; right: 0; height: max(64px, calc(266 * (100vw / 4796))); container-type: inline-size; pointer-events: none;
    transition: background .35s ease, box-shadow .35s ease; }
  .efd-hdr > * { pointer-events: auto; }
  .efd-hdr { --efd-u: calc(100cqw / 4796); }
  .efd-hdr::before { content: ''; position: absolute; inset: 0 0 -40px 0; z-index: -1; pointer-events: none; background: linear-gradient(rgb(0 0 0 / .5), transparent); transition: opacity .35s; }
  html.scrolled .efd-hdr, html.solid-header .efd-hdr { background: rgb(5 7 11 / .9); -webkit-backdrop-filter: saturate(160%) blur(14px); backdrop-filter: saturate(160%) blur(14px); box-shadow: 0 1px 0 rgb(251 119 4 / .35); }
  html.scrolled .efd-hdr::before, html.solid-header .efd-hdr::before { opacity: 0; }
  .efd-hdr-logo { position: absolute; left: calc(160 * var(--efd-u)); top: 50%; transform: translateY(-50%); display: block; transition: opacity .3s; }
  .efd-hdr-logo img { display: block; width: auto; height: max(46px, calc(200 * var(--efd-u))); }
  .efd-btn-in { display: inline-flex; align-items: center; gap: .45em; }
  .efd-mmenu .efd-caret { display: inline-block; width: .5em; height: .5em; margin-left: .35em; vertical-align: .12em; }
  .efd-mmenu details[open] .efd-caret { transform: rotate(180deg); }
  .efd-mmenu summary { list-style: none; } .efd-mmenu summary::-webkit-details-marker { display: none; }
  /* homepage: the logo is part of the hero picture at the top, the header shows its own once scrolled; no dark gradient on the design */
  html:has(.efd) .efd-hdr::before { display: none; }
  @media (min-width: 861px) { html:has(.efd):not(.scrolled) .efd-hdr-logo { opacity: 0; pointer-events: none; } }
  @media (max-width: 860px) {
    .efd-hdr { height: 74px; }
    .efd-hdr-logo { left: 14px; }
    .efd-hdr-logo img { height: 50px; }
    .efd-burger { position: absolute; }
    .efd-mmenu:not([hidden]) { z-index: 49; padding: 90px 22px calc(110px + env(safe-area-inset-bottom)); }
    .efd-mmenu nav { display: block; }
    .efd-mmenu a, .efd-mmenu summary { min-height: 48px; display: flex; align-items: center; }
    .efd-mmenu .efd-mm-sub a { min-height: 44px; }
    @media (hover: none) { .efd-mmenu summary:hover, .efd-mmenu a:hover { color: #fff; } .efd-mmenu .efd-mm-sub a:hover { color: #d6dae2; } .efd-mmenu a[aria-current="page"] { color: var(--efd-orange-hot); } }
    .efd-mm-cta { display: grid; gap: 12px; margin-top: 26px; }
    .efd-mmenu .efd-mm-cta .efd-btn { display: flex; width: 100%; height: 56px; margin: 0; padding: 0 16px; font-size: 21px; border-radius: 8px; border-bottom: 0; }
    .efd-mmenu .efd-mm-cta .efd-btn-ghost { border: 2px solid rgba(255,255,255,.85); color: #fff; background: rgba(255,255,255,.04); }
    .efd-mmenu .efd-mm-cta .efd-btn-orange { color: #140800; }
    .efd-mbar { z-index: 48; }
    #efc-chat-bubble { display: none !important; }
    body { padding-bottom: calc(76px + env(safe-area-inset-bottom)); }
  }
  html.efd-menu-open, html.efd-menu-open body { overflow: hidden; }
  html.efd-menu-open .efd-hdr { background: rgb(5 7 11); box-shadow: 0 1px 0 rgb(251 119 4 / .35); }
  html.efd-menu-open .efd-hdr::before { opacity: 0; }
  html.efd-menu-open .efd-hdr-logo { opacity: 1 !important; }
</style>

<script>
  const root = document.documentElement;
  const onScroll = () => root.classList.toggle('scrolled', scrollY > 40);
  addEventListener('scroll', onScroll, { passive: true }); onScroll();

  // desktop dropdown: hover (mouse), click/tap, keyboard
  const dd = document.getElementById('efd-dd'), ddBtn = dd?.querySelector<HTMLButtonElement>('.efd-dd-btn'), panel = document.getElementById('efd-dd-panel');
  if (dd && ddBtn && panel) {
    const setDD = (on: boolean) => { dd.classList.toggle('open', on); ddBtn.setAttribute('aria-expanded', String(on)); };
    let hoverT: number | undefined, lastPointer = '';
    dd.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') { clearTimeout(hoverT); setDD(true); } });
    dd.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') hoverT = window.setTimeout(() => setDD(false), 180); });
    ddBtn.addEventListener('pointerdown', (e) => { lastPointer = e.pointerType; });
    ddBtn.addEventListener('click', () => { setDD(lastPointer === 'mouse' ? true : !dd.classList.contains('open')); lastPointer = ''; });
    dd.addEventListener('keydown', (e) => {
      const items = [...panel.querySelectorAll<HTMLAnchorElement>('a')], i = items.indexOf(document.activeElement as HTMLAnchorElement);
      if (e.key === 'Escape') { setDD(false); ddBtn.focus(); }
      if (e.key === 'ArrowDown') { e.preventDefault(); setDD(true); items[Math.min(i + 1, items.length - 1)].focus(); }
      if (e.key === 'ArrowUp') { e.preventDefault(); if (i <= 0) ddBtn.focus(); else items[i - 1].focus(); }
    });
    dd.addEventListener('focusout', (e) => { if (!dd.contains(e.relatedTarget as Node)) setDD(false); });
    document.addEventListener('click', (e) => { if (!dd.contains(e.target as Node)) setDD(false); });
  }

  // mobile menu: open/close, closes after a link is chosen, page scroll locked while open
  const burger = document.querySelector<HTMLButtonElement>('.efd-burger'), mm = document.getElementById('efd-mmenu');
  if (burger && mm) {
    const setMM = (on: boolean) => {
      mm.hidden = !on; burger.setAttribute('aria-expanded', String(on)); burger.setAttribute('aria-label', on ? 'Close menu' : 'Open menu');
      root.classList.toggle('efd-menu-open', on);
      if (!on) mm.querySelectorAll('details[open]').forEach((d) => d.removeAttribute('open'));
    };
    burger.addEventListener('click', () => setMM(mm.hidden));
    mm.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) setMM(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !mm.hidden) { setMM(false); burger.focus(); } });
    matchMedia('(min-width: 861px)').addEventListener('change', (m) => { if (m.matches) setMM(false); });
  }
</script>
