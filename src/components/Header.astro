---
import { NAV, SITE } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const LOGO = `https://images.squarespace-cdn.com/content/v1/6911316472567617bebc28b5/${SITE.logo}`;
---
<a class="skip-link" href="#main">Skip to Content</a>
<header class="hdr" id="header">
  <a class="hdr-logo" href="/" aria-label="Exotic Fish Cabo — home">
    <img src={`${LOGO}?format=300w`} srcset={`${LOGO}?format=300w 1x, ${LOGO} 2x`} alt="EXOTIC FISH CABO" width="216" height="175" fetchpriority="high" />
  </a>

  <nav class="hdr-nav" aria-label="Main">
    <ul>
      {NAV.map((item) =>
        item.children ? (
          <li class="dd">
            <button class="dd-toggle" type="button" aria-expanded="false" aria-controls="dd-explore">
              {item.label}
            </button>
            <ul class="dd-panel" id="dd-explore">
              {item.children.map((c) => (
                <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>
              ))}
            </ul>
          </li>
        ) : (
          <li><a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a></li>
        )
      )}
    </ul>
  </nav>

  <div class="hdr-cta">
    <a class="cta cta-gps" href={SITE.gpsUrl} target="_blank" rel="noopener" data-track="marina_gps">MARINA GPS</a>
    <a class="cta cta-book" href={SITE.bookUrl} data-track="book_now_header">BOOK NOW</a>
  </div>

  <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
    <span></span><span></span>
  </button>
</header>

<div class="mmenu" id="mobile-menu" hidden>
  <nav aria-label="Mobile">
    {NAV.map((item) =>
      item.children ? (
        <details>
          <summary>{item.label}</summary>
          <div class="mmenu-sub">
            {item.children.map((c) => <a href={c.href}>{c.label}</a>)}
          </div>
        </details>
      ) : (
        <a href={item.href}>{item.label}</a>
      )
    )}
  </nav>
</div>

<!-- Mobile bottom action bar (replicates the efc2 bar, ≤800px) -->
<div class="mbar" aria-label="Quick actions">
  <a class="cta cta-gps" href={SITE.gpsUrl} target="_blank" rel="noopener" data-track="marina_gps_mobile">MARINA GPS</a>
  <a class="cta cta-book" href={SITE.bookUrl} data-track="book_now_mobile">BOOK NOW</a>
</div>

<style>
  .hdr {
    position: absolute; inset: 0 0 auto 0; z-index: 50;
    display: flex; align-items: center; gap: 2.6vw;
    height: 74px; padding: 0 var(--gutter);
    color: var(--white);
  }
  .hdr-logo { flex: none; display: block; }
  .hdr-logo img { width: auto; height: 71px; }
  .hdr-nav ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 38px; }
  .hdr-nav a, .dd-toggle {
    font-family: var(--font-ui); font-size: 12px; font-weight: 600; letter-spacing: 0.025em;
    color: inherit; text-decoration: none; background: none; border: 0; padding: 6px 0; cursor: pointer;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.25);
  }
  .hdr-nav > ul > li > a:hover, .dd-toggle:hover { opacity: 0.8; }
  .hdr-nav [aria-current='page'] { text-decoration: underline; text-underline-offset: 4px; }
  .dd { position: relative; }
  .dd-panel {
    position: absolute; top: calc(100% + 8px); left: -12px;
    display: none !important; flex-direction: column; align-items: stretch; gap: 0 !important;
    width: 245px; padding: 10px 12px !important;
    background: var(--ink); border: 1px solid rgb(255 255 255 / 0.12); border-radius: 10px;
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.24);
  }
  .dd-panel::before { content: ''; position: absolute; inset: -10px 0 auto 0; height: 10px; } /* hover bridge */
  @media (hover: hover) { .dd:hover .dd-panel { display: flex !important; } }
  .dd.open .dd-panel { display: flex !important; }
  .dd-panel a {
    display: block; padding: 10px 12px; border-radius: 5px; color: #f4f4f4;
    font-weight: 500; line-height: 1.4; text-shadow: none;
    transition: color 0.18s ease, background 0.18s ease;
  }
  .dd-panel a:hover { background: rgb(255 138 0 / 0.1); color: var(--orange-hover); }

  .hdr-cta { margin-left: auto; display: flex; gap: 8px; }
  .cta {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 40px; padding: 9px 14px; border-radius: 5px;
    font-family: var(--font-body); font-size: 12px; font-weight: 700; letter-spacing: 0.02em; line-height: 1.2;
    white-space: nowrap; text-decoration: none; transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .cta:hover { opacity: 0.85; transform: translateY(-1px); }
  .cta-gps { background: rgb(0 0 0 / 0.25); color: var(--white); border: 1px solid var(--white); }
  .cta-book { background: var(--yellow); color: var(--ink); border: 1px solid var(--yellow); }

  .burger { display: none; }
  .mbar { display: none; }
  .mmenu { position: fixed; inset: 0; z-index: 60; background: var(--ink); color: var(--white); overflow-y: auto; padding: 96px var(--gutter) 120px; }
  .mmenu nav { display: flex; flex-direction: column; gap: 6px; }
  .mmenu a, .mmenu summary {
    display: block; padding: 12px 0; font-family: var(--font-ui); font-size: 26px; font-weight: 600;
    color: inherit; text-decoration: none; cursor: pointer; list-style: none;
  }
  .mmenu summary::-webkit-details-marker { display: none; }
  .mmenu summary::after { content: ' +'; color: var(--orange-ui); }
  .mmenu details[open] summary::after { content: ' −'; }
  .mmenu-sub { padding: 0 0 8px 16px; }
  .mmenu-sub a { font-size: 18px; font-weight: 500; padding: 9px 0; color: #f4f4f4; }

  @media (max-width: 800px) {
    .hdr { height: 74px; }
    .hdr-logo img { height: 58px; }
    .hdr-nav, .hdr-cta { display: none; }
    .burger {
      display: flex; flex-direction: column; justify-content: center; gap: 10px;
      margin-left: auto; width: 44px; height: 44px; padding: 0; background: none; border: 0; cursor: pointer; z-index: 70;
    }
    .burger span { display: block; width: 36px; height: 1px; background: var(--white); margin-left: auto; transition: transform 0.2s ease; }
    .burger[aria-expanded='true'] { position: fixed; top: 15px; right: var(--gutter); }
    .burger[aria-expanded='true'] span:first-child { transform: translateY(5.5px) rotate(45deg); }
    .burger[aria-expanded='true'] span:last-child { transform: translateY(-5.5px) rotate(-45deg); }
    .mbar {
      display: flex; gap: 8px; position: fixed; inset: auto 0 0 0; z-index: 55;
      padding: 8px 12px calc(8px + env(safe-area-inset-bottom, 0px));
      background: rgb(23 23 23 / 0.94);
    }
    .mbar .cta { flex: 1 1 0; min-height: 44px; font-size: 13px; }
    :global(body) { padding-bottom: 60px; }
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const menu = document.getElementById('mobile-menu');
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') !== 'true';
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    if (menu) menu.hidden = !open;
    document.documentElement.style.overflow = open ? 'hidden' : '';
  });
  // Dropdown: click/keyboard support in addition to hover.
  document.querySelectorAll<HTMLButtonElement>('.dd-toggle').forEach((btn) => {
    const li = btn.parentElement!;
    btn.addEventListener('click', () => {
      const open = !li.classList.contains('open');
      li.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
    });
    li.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape') { li.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); btn.focus(); }
    });
    document.addEventListener('click', (e) => {
      if (!li.contains(e.target as Node)) { li.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); }
    });
  });
</script>
