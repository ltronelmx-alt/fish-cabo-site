---
/**
 * CCK cross-promotion — owner-approved vertical creative, 18 Nov 2026.
 * IMPORTANT: Claude/other deployments must retain this component and its image.
 * Never show while a reservation / payment flow is in progress.
 */
const cckUrl = 'https://cabocasitakeeper.com/vacation-rentals-los-cabos';
---
<dialog id="efc-cck-dialog" class="efc-cck-popup" aria-label="Cabo Casita Keeper vacation rental suggestion" aria-modal="true">
  <img
    class="efc-cck-art"
    src="/media/cck/cck-popup-approved.webp"
    width="500"
    height="625"
    alt="Cabo Casita Keeper — Vacation rentals in Los Cabos. Hey! Haven't booked your stay yet? Make your fishing trip complete with the perfect place to stay in Los Cabos. Vacation Rentals, Concierge Services, Property Management. Explore Vacation Rentals."
    decoding="async"
  />
  <button class="efc-cck-close" type="button" aria-label="Close vacation rental offer" title="Close"><span class="efc-cck-visually-hidden">Close</span></button>
  <a class="efc-cck-link" href={cckUrl} target="_blank" rel="noopener noreferrer" aria-label="Explore Cabo Casita Keeper vacation rentals in Los Cabos (opens in new tab)" data-track="cck_popup_vacation_rentals"><span class="efc-cck-visually-hidden">Explore vacation rentals at Cabo Casita Keeper</span></a>
</dialog>

<style>
  .efc-cck-popup {
    box-sizing: border-box;
    position: fixed;
    inset: 0;
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
    width: min(500px, 94vw, 70.4dvh);
    max-width: 94vw;
    max-height: 88dvh;
    overflow: visible;
    isolation: isolate;
    border-radius: 7%;
    box-shadow: 0 22px 84px rgb(0 0 0 / .75);
  }
  .efc-cck-popup::backdrop { background: rgb(1 5 10 / .77); backdrop-filter: blur(5px); }
  .efc-cck-art { display: block; width: 100%; height: auto; border-radius: inherit; }
  .efc-cck-close, .efc-cck-link { position: absolute; padding: 0; border: 0; background: transparent; cursor: pointer; }
  /* Transparent hit areas over the approved graphic's visible CLOSE and CTA. */
  .efc-cck-close { z-index: 2; top: 2.3%; right: 3.2%; width: 11%; height: 9.1%; border-radius: 50%; }
  .efc-cck-link { z-index: 1; left: 8.2%; bottom: 4.8%; width: 83.6%; height: 11.5%; border-radius: 16px; }
  .efc-cck-close:focus-visible, .efc-cck-link:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
    box-shadow: 0 0 0 6px #fba72e;
  }
  .efc-cck-visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 480px) {
    .efc-cck-popup { width: min(96vw, 70.4dvh); }
  }
</style>

<script>
  // Deliberately isolated from booking, payment, header and contact submission code.
  const popup = document.getElementById('efc-cck-dialog') as HTMLDialogElement | null;
  if (popup && typeof popup.showModal === 'function') {
    const path = window.location.pathname.toLowerCase();
    const blocked = /^\/(?:book-now|api)(?:\/|$)/.test(path)
      || /\/(?:checkout|payment|confirmation|canceled|cancelled)(?:\/|$)/.test(path)
      || new URLSearchParams(location.search).has('checkout');
    const seenKey = 'efc_cck_popup_seen_v2';
    const visitKey = 'efc_cck_visit_last_active_v2';
    const safeGet = (store: Storage, key: string) => { try { return store.getItem(key); } catch { return null; } };
    const safeSet = (store: Storage, key: string, value: string) => { try { store.setItem(key, value); } catch { /* privacy mode */ } };
    // Treat each arrival from outside EFC as a new visit, even in the same tab.
    // Internal page changes and reloads remain part of the current visit.
    const navigation = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
    const referrerOutside = !document.referrer || new URL(document.referrer).origin !== location.origin;
    const previousActivity = Number(safeGet(sessionStorage, visitKey) || 0);
    const newVisit = (navigation?.type === 'navigate' && referrerOutside)
      || !previousActivity || Date.now() - previousActivity > 30 * 60 * 1000;
    if (newVisit) {
      try { sessionStorage.removeItem(seenKey); } catch { /* privacy mode */ }
    }
    const markVisitActivity = () => safeSet(sessionStorage, visitKey, String(Date.now()));
    markVisitActivity();
    // Refresh the visit activity stamp only on real user interaction.
    document.addEventListener('pointerdown', markVisitActivity, { passive: true });
    document.addEventListener('keydown', markVisitActivity, { passive: true });
    const firstSeenAt = Date.now();
    let shownHere = false;
    let lastActive: Element | null = null;

    const allowed = () =>
      !blocked && !shownHere && !popup.open &&
      !safeGet(sessionStorage, seenKey);

    const show = () => {
      if (!allowed()) return;
      shownHere = true;
      lastActive = document.activeElement;
      try { popup.showModal(); } catch { return; }
      shownHere = true;
      safeSet(sessionStorage, seenKey, '1');
      (popup.querySelector('.efc-cck-close') as HTMLButtonElement | null)?.focus({ preventScroll: true });
    };

    if (!blocked) {
      const close = popup.querySelector('.efc-cck-close') as HTMLButtonElement | null;
      const link = popup.querySelector('.efc-cck-link') as HTMLAnchorElement | null;
      close?.addEventListener('click', () => popup.close());
      link?.addEventListener('click', () => {
        popup.close();
      });
      popup.addEventListener('click', (event) => {
        if (event.target === popup) popup.close();
      });
      popup.addEventListener('close', () => {
        if (lastActive instanceof HTMLElement && lastActive.isConnected) lastActive.focus({ preventScroll: true });
      });

      // Priority: successful real contact form submission (never on errors or staging test sends).
      document.addEventListener('efc:contact-success', () => window.setTimeout(show, 1100));

      // Desktop: proactively detect the cursor moving UP towards the browser controls.
      // Waiting until the pointer actually leaves the viewport misses many tab closes.
      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        let prevX = -1;
        let prevY = -1;
        let hasBrowsedPage = false;
        let headingTowardClose = false;
        const desktopExit = () => {
          // Only actual exit-style movement, never an automatic time-based popup.
          if (Date.now() - firstSeenAt < 7000 || !hasBrowsedPage) return;
          if (document.activeElement?.matches('input, textarea, select, [contenteditable="true"]')) return;
          show();
        };
        document.addEventListener('pointermove', (e) => {
          if (e.pointerType !== 'mouse') return;
          const x = e.clientX;
          const y = e.clientY;
          // The visitor must first have moved the mouse within the content.
          if (y > 140) hasBrowsedPage = true;
          if (prevY >= 0) {
            const movingUp = y < prevY;
            const movingRight = x > prevX;
            // Detect a deliberate upward/rightward approach to the browser's X.
            if (movingUp && movingRight && y > 90) headingTowardClose = true;
            // Cancel stale approach when the user reverses direction.
            if (y > prevY + 12 || x < prevX - 35) headingTowardClose = false;
            const insideUpperRight = x >= window.innerWidth * .74 && y <= 65;
            const enteredUpperRight = prevX < window.innerWidth * .74 || prevY > 65;
            if (insideUpperRight && enteredUpperRight && movingUp && headingTowardClose) desktopExit();
            // Retain original top-edge exit detection elsewhere on desktop.
            const crossedTopEdge = prevY >= 45 && y <= 45;
            if (movingUp && crossedTopEdge) desktopExit();
          }
          prevX = x;
          prevY = y;
        }, { passive: true });
        document.addEventListener('mouseout', (event) => {
          const e = event as MouseEvent;
          if (e.relatedTarget || e.clientY > 12) return;
          desktopExit();
        });
      }

      // Mobile: FIRST tap on the visible header logo per VISIT, not per browser session.
      // Delegate in capture phase: works with iPhone/Android and hybrid touch devices,
      // independently of desktop hover/pointer media feature detection.
      document.addEventListener('click', (event) => {
        if (window.innerWidth > 860) return;
        const target = event.target;
        if (!(target instanceof Element) || !target.closest('.efd-hdr-logo')) return;
        if (!allowed()) return; // after first display, logo navigates home normally
        event.preventDefault();
        show();
      }, { capture: true });
    }
  }
</script>
