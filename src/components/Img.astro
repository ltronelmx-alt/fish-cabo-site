---
// Responsive, self-hosted image: AVIF + WebP at several widths, real width/height
// (no layout shift), lazy-loaded unless it is the hero (LCP) image.
import { media } from '../lib/media';
interface Props {
  src: string; // original path "uuid/File+Name.webp"
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  priority?: boolean;
  class?: string;
}
const { src, alt, sizes = '100vw', priority = false, class: cls } = Astro.props;
const m = media(src);
---
<picture>
  <source type="image/avif" srcset={m.avif} sizes={sizes} />
  <img
    src={m.at(1000)}
    srcset={m.webp}
    sizes={sizes}
    alt={alt}
    width={m.width}
    height={m.height}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : undefined}
    class={cls}
  />
</picture>
