---
import { createHash } from 'node:crypto';
import { readFileSync as rfs } from 'node:fs';
const V = createHash('sha1').update(rfs('public/js/efc-chat.js')).digest('hex').slice(0, 8); // cache-busting version
// Original multilingual chat assistant (EN/ES/FR + WhatsApp handoff), ported verbatim from fish-cabo.com.
import '../styles/chat.css';
---
<div aria-label="Open chat" id="efc-chat-bubble" role="button" tabindex="0">
<svg viewbox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20.52 3.48A11.83 11.83 0 0 0 12 0C5.37 0 0 5.37 0 12c0 2.11.55 4.1 1.52 5.83L0 24l6.4-1.68A11.94 11.94 0 0 0 12 24c6.63 0 12-5.37 12-12 0-3.2-1.25-6.21-3.48-8.52zM12 21.8a9.77 9.77 0 0 1-4.98-1.36l-.36-.22-3.82 1 1.02-3.72-.24-.38A9.79 9.79 0 0 1 2.2 12 9.8 9.8 0 0 1 12 2.2 9.8 9.8 0 0 1 21.8 12a9.79 9.79 0 0 1-9.8 9.8zm5.4-7.38c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.34.22-.64.07-.3-.15-1.26-.46-2.4-1.47a8.9 8.9 0 0 1-1.65-2.02c-.17-.3 0-.46.13-.6.13-.13.3-.34.44-.5.15-.17.2-.28.3-.47.1-.2.05-.36-.02-.5-.08-.15-.67-1.6-.92-2.2-.24-.57-.48-.5-.67-.5l-.57-.01c-.2 0-.5.07-.77.36-.27.3-1.03 1.01-1.03 2.46s1.06 2.86 1.2 3.05c.15.2 2.1 3.2 5.08 4.48.7.3 1.25.48 1.68.62.7.22 1.34.19 1.84.12.56-.08 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.18-.57-.33z"></path></svg>
</div>
<div id="efc-chat-window">
<div id="efc-header">
<img alt="" src="/favicon.ico"/>
<div id="efc-header-text">
<h3>Exotic Fish Cabo</h3>
<p id="efc-status">🎣 Fishing Assistant • Online</p>
</div>
<div id="efc-lang-selector">
<button id="btn-en" type="button" lang="en" aria-label="English">EN</button>
<button id="btn-es" type="button" lang="es" aria-label="Español">ES</button>
<button id="btn-fr" type="button" lang="fr" aria-label="Français">FR</button>
</div>
<button id="efc-close" type="button" aria-label="Close chat">×</button>
</div>
<div id="efc-messages"></div>
<div id="efc-input-area">
<input id="efc-input" placeholder="Ask your question..." type="text" aria-label="Your message" autocomplete="off"/>
<button id="efc-send" type="button" aria-label="Send">
<svg viewbox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"></path></svg>
</button>
</div>
</div>
<script is:inline src={`/js/efc-chat.js?v=${V}`} defer></script>
