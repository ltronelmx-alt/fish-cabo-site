---
// HOME — content, headings, links, alt texts, meta and JSON-LD are the ORIGINAL ones (verbatim,
// from src/data/original/home.json). This file only decides the layout/design.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Rich from '../components/Rich.astro';
import OImg from '../components/OImg.astro';
import OBtn from '../components/OBtn.astro';
import LatestLog from '../components/LatestLog.astro';
import { PAGES, byH2 } from '../lib/original';

const P = PAGES.home;
const S = P.sections;
const [s0, s1, , s3, s4, s5, s6] = S;
const txt = (s: typeof s0) => s.blocks.filter((b) => b.kind === 'text');
const img = (s: typeof s0) => s.blocks.filter((b) => b.kind === 'img');
const btn = (s: typeof s0) => s.blocks.filter((b) => b.kind === 'button');
const c1 = byH2(txt(s1)[0].html!); // intro · why choose · about · book
const c4 = byH2(txt(s4)[0].html!); // areas · different · fish
---
<Base original={P}>
  <Hero variant="home" position="60% 30%" image={{ src: s0.bg!.path, alt: s0.bg!.alt }}>
    {txt(s0).map((b) => <div class="hero-text" set:html={b.html} />)}
  </Hero>

  <!-- Section 1 (one original text block, shown as 4 bands) -->
  <section class="section bg-white"><div class="container"><Rich html={c1[0]} class="reveal intro" /></div></section>
  <section class="section bg-sand"><div class="container"><Rich html={c1[1]} mode="cards" class="center-head" /></div></section>
  <section class="section bg-white"><div class="container"><Rich html={c1[2]} class="two-col reveal" /></div></section>
  <section class="section bg-black dark"><div class="container"><Rich html={c1[3]} class="two-col cta-links reveal" /></div></section>

  <!-- Section 2: latest fishing log -->
  <section class="section tight bg-orange"><div class="container"><LatestLog /></div></section>

  <!-- Section 3 -->
  <section class="section bg-sand">
    <div class="container">
      <OImg block={img(s3)[0]} class="wide reveal" sizes="(min-width: 1240px) 1160px, 92vw" />
      <Rich html={txt(s3)[0].html!} mode="cards" class="after-img" />
      <div class="btn-row center">{btn(s3).map((b) => <OBtn block={b} track="home_contact_btn" />)}</div>
    </div>
  </section>

  <!-- Section 4: original DOM order kept (text, image, button); layout done with CSS grid -->
  <section class="section bg-white s4">
    <div class="container s4grid">
      <Rich html={c4[0]} class="s4a reveal" />
      <Rich html={c4[1]} mode="cards" class="s4b band band-sand" />
      <Rich html={c4[2]} mode="cards" class="s4c band band-black dark species" />
      <OImg block={img(s4)[0]} class="s4img ratio-3x2 reveal" sizes="(min-width: 900px) 46vw, 92vw" />
      <div class="btn-row s4btn">{btn(s4).map((b) => <OBtn block={b} />)}</div>
    </div>
  </section>

  <!-- Section 5 -->
  <section class="section bg-white">
    <div class="container split top">
      <OImg block={img(s5)[0]} class="ratio-4x3 sticky reveal" sizes="(min-width: 900px) 46vw, 92vw" />
      <Rich html={txt(s5)[0].html!} class="reveal" />
    </div>
  </section>

  <!-- Section 6: FAQ (original DOM order: image, text, buttons) -->
  <section class="section bg-sand">
    <div class="container s6grid">
      <OImg block={img(s6)[0]} class="s6img ratio-4x3 reveal" sizes="(min-width: 900px) 46vw, 92vw" />
      <Rich html={txt(s6)[0].html!} class="s6txt faq-list reveal" />
      <div class="btn-row s6btn">{btn(s6).map((b, i) => <OBtn block={b} primary={i === 0} track={i === 0 ? 'home_faq_book' : undefined} />)}</div>
    </div>
  </section>
</Base>

<style is:global>
  .hero-text h1 { margin-bottom: 0.4em; }
  .hero-text p { max-width: 900px; font-size: var(--fs-lead); line-height: 1.6; }
  .hero-text p strong { font-weight: 400; color: #f0f0f0; }
  .intro h2 { max-width: none; }
  .center-head > h2 { text-align: center; max-width: 20ch; margin-inline: auto; }
  .center-head > h2::before { margin-inline: auto; }
  .two-col { display: block; }
  .two-col > h2 { grid-column: 1; grid-row: 1 / span 20; margin-top: 0; }
  .two-col > :not(h2) { grid-column: 2; }
  @media (max-width: 900px) { .two-col { grid-template-columns: 1fr; } .two-col > * { grid-column: 1 !important; grid-row: auto !important; } }
  .cta-links p:has(> a) { display: inline-block; margin: 18px 12px 0 0; }
  .cta-links p > a:only-child { display: inline-flex; align-items: center; min-height: 54px; padding: 15px 26px; border: 1.5px solid currentColor; border-radius: var(--radius-sm); text-decoration: none; font-size: 13px; letter-spacing: 0.06em; }
  .cta-links p:has(> a:only-child):first-of-type > a, .cta-links p:has(> a[href='/fishing-boats']) > a { background: var(--yellow); border-color: var(--yellow); color: var(--ink); }
  .cta-links p > a:only-child strong { color: inherit; }
  .after-img { margin-top: clamp(40px, 5vw, 72px); }
  .species .card { border-color: rgb(255 255 255 / 0.1); }
  .faq-list h3 { padding-top: 24px; border-top: 1px solid var(--line); margin-top: 24px; }
  .faq-list h2 + h3 { margin-top: 32px; }
  .s4grid { display: grid; grid-template-columns: minmax(0, 1fr); column-gap: clamp(32px, 6vw, 96px); align-items: start; }
  .s4a { grid-column: 1; grid-row: 1; }
  .s4img { grid-column: 1; grid-row: 2; margin-top: 40px; }
  .s4btn { grid-column: 1; grid-row: 3; align-self: start; }
  .s4b { grid-column: 1; grid-row: 4; }
  .s4c { grid-column: 1; grid-row: 5; }
  .band { position: relative; margin-top: var(--section-pad); padding-block: var(--section-pad); }
  .s4b { margin-top: var(--section-pad); }
  .band-sand { box-shadow: 0 0 0 100vmax var(--sand); clip-path: inset(0 -100vmax); background: var(--sand); }
  .band-black { box-shadow: 0 0 0 100vmax var(--ink); clip-path: inset(0 -100vmax); background: var(--ink); margin-bottom: calc(-1 * var(--section-pad)); }
  .s4c h2, .s4c h3, .s4c strong { color: var(--white); }
  .s6grid { display: grid; grid-template-columns: minmax(0, 1fr); column-gap: clamp(32px, 6vw, 96px); align-items: start; }
  .s6img { grid-column: 1; grid-row: 1; }
  .s6btn { grid-column: 1; grid-row: 3; align-self: start; }
  .s6txt { grid-column: 1; grid-row: 2; margin-top: 40px; }
  @media (max-width: 900px) {
    .s4grid, .s6grid { grid-template-columns: 1fr; }
    .s4grid > *, .s6grid > * { grid-column: 1 !important; grid-row: auto !important; }
    .s4img { margin-top: 32px; }

  }
  .faq-list > h3, .faq-list > p { max-width: none; }
  /* Book-your-charter facts shown as tiles (original paragraphs, CSS only) */
  .cta-links > p:has(> strong:first-child):not(.sub) { display: inline-block; vertical-align: top; width: calc(50% - 10px); margin: 0 6px 12px 0; padding: 20px 24px; border: 1px solid rgb(255 255 255 / 0.12); border-radius: var(--radius-sm); background: rgb(255 255 255 / 0.04); }
  .cta-links > p:has(> strong:first-child):not(.sub) strong { display: block; color: var(--orange); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; margin-bottom: 4px; }
  @media (min-width: 1100px) { .cta-links > p:has(> strong:first-child):not(.sub) { width: calc(25% - 10px); } }
  @media (max-width: 640px) { .cta-links > p:has(> strong:first-child):not(.sub) { width: 100%; } }
</style>
