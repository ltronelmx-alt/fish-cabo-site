---
// FISHING BOATS — ORIGINAL content/SEO verbatim (src/data/original/fishing-boats.json); design only here.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Rich from '../components/Rich.astro';
import OImg from '../components/OImg.astro';
import OBtn from '../components/OBtn.astro';
import { PAGES, type Block } from '../lib/original';
import catalogue from '../data/boats.json';
import { BOOKING_OPEN } from '../lib/launch';
import BoatShowcase from '../components/BoatShowcase.astro';
import showcase from '../data/boat-showcase.json';
const bookId = (href = '') => catalogue.boats.find((x) => x.url === href.replace(/^https?:\/\/[^/]+/, '').replace(/\/$/, ''))?.id;

const P = PAGES['fishing-boats'];
const [s0, s1, s2, s3, s4, s5] = P.sections;
// A boat card = the original blocks that share the same grid column (image, h4, text, button), top to bottom.
function cards(blocks: Block[]) {
  const narrow = blocks.filter((b) => b.ga[3] - b.ga[1] <= 12);
  const cols = [...new Set(narrow.map((b) => b.ga[1]))].sort((a, b) => a - b);
  return cols.map((c) => narrow.filter((b) => b.ga[1] === c).sort((a, b) => a.ga[0] - b.ga[0]));
}
const intro = s1.blocks.filter((b) => b.ga[3] - b.ga[1] > 12);
const faq = s4.blocks.filter((b) => b.ga[3] - b.ga[1] > 12);
---
<Base original={P}>
  <Hero position="50% 40%" image={{ src: s0.bg!.path, alt: s0.bg!.alt }}>
    {s0.blocks.map((b) => <div set:html={b.html} />)}
  </Hero>

  <section class="section bg-white">
    <div class="container">{intro.map((b) => <Rich html={b.html!} class="boats-intro reveal" />)}</div>
  </section>

  <!-- Online booking open: 10 large boat showcases (owner 2026-11-09). Closed: the original cards below. -->
  {BOOKING_OPEN && showcase.boats.map((b, k) => <BoatShowcase boat={b} included={showcase.included} flip={k % 2 === 1} first={k === 0} />)}

  <!-- Boat sections (booking closed): blocks in ORIGINAL DOM order; each boat card is assembled visually with CSS grid -->
  {!BOOKING_OPEN && [s1, s2, s3, s4].map((sec, si) => {
    const cs = cards(sec.blocks);
    const pos = new Map<Block, string>();
    cs.forEach((card, ci) => card.forEach((b, ri) => pos.set(b, `grid-column:${ci + 1};grid-row:${ri + 1};--o:${ci * 10 + ri}`)));
    const ordered = sec.blocks.slice().sort((x, y) => (x as any).dom - (y as any).dom).filter((b) => pos.has(b));
    return (
      <section class:list={['section fleet', si % 2 ? 'bg-white' : 'bg-sand', cs.length === 2 && 'two']}>
        <div class="container boats" style={`--n:${cs.length}`}>
          {ordered.map((b) =>
            b.kind === 'img' ? <OImg block={b} class="boat-media" sizes="(min-width: 1000px) 30vw, 92vw" style={pos.get(b)} /> :
            b.kind === 'button' ? <div class="boat-btn" style={pos.get(b)}>{!(BOOKING_OPEN && bookId(b.href)) && <OBtn block={b} track={`boat_${(b.href || '').split('/').pop()}`} />}{BOOKING_OPEN && bookId(b.href) && <a class="btn btn-primary" data-booking href={`/book-now?boat=${bookId(b.href)}`} data-track={`book_this_boat_${bookId(b.href)}`}>BOOK THIS BOAT</a>}</div> :
            <div class="boat-text rich" style={pos.get(b)} set:html={b.html} />
          )}
        </div>
      </section>
    );
  })}

  <section class="section bg-white">
    <div class="container">{faq.map((b) => <Rich html={b.html!} class="faq-list reveal" />)}
      <div class="btn-row">{s5.blocks.map((b) => <OBtn block={b} />)}</div>
    </div>
  </section>
</Base>

<style>
  .boat-btn .btn-primary { min-width: 220px; justify-content: center; }
  :global(.boats-intro) { max-width: none; }
  .fleet { padding-block: clamp(40px, 5vw, 72px); }
  .boats { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); column-gap: clamp(18px, 2vw, 28px); row-gap: 0; }
  .two .boats { max-width: none; }
  .boats > :global(*) { background: var(--white); }
  .bg-white .boats > :global(*) { background: var(--sand); }
  .boats :global(.boat-media) { border-radius: var(--radius) var(--radius) 0 0; }
  .boat-text { padding: 20px 24px 0; }
  .boat-text :global(h4) { margin: 0; }
  .boat-text :global(p) { font-size: 0.93em; margin: 0; }
  .boat-btn { padding: 22px 24px 26px; border-radius: 0 0 var(--radius) var(--radius); display: flex; flex-direction: column; justify-content: flex-end; gap: 10px; }
  .boat-btn :global(.btn) { width: 100%; min-width: 0 !important; }
  @media (max-width: 760px) {
    .boats { grid-template-columns: 1fr; row-gap: 0; }
    .boats > :global(*) { grid-column: 1 !important; grid-row: auto !important; order: var(--o); }
    .boats :global(.boat-media) { margin-top: 28px; }
  }
  :global(.faq-list h3) { padding-top: 24px; border-top: 1px solid var(--line); margin-top: 24px; }
  :global(.faq-list) { max-width: none; }
</style>
