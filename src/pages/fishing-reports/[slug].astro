---
// A Fishing Report / weekly Fishing Log. Imported articles: ORIGINAL head + ORIGINAL HTML body.
// New CMS articles (Markdown): head built from the SEO fields; same layout.
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { published, catUrl, tagUrl } from '../../lib/reports';
import { pictures, media } from '../../lib/media';
import { demoteBodyH1 } from '../../lib/seo-fixes';
// F5 — keep the article title as the only H1: any further <h1> in the imported body becomes <h2 class="as-h1">
const demoteBodyH1Keep = (html: string) => { let first = true; return html.replace(/<h1(\s[^>]*)?>[\s\S]*?<\/h1>/g, (m) => (first ? ((first = false), m) : demoteBodyH1(m))); };
import { SITE } from '../../data/site';
export async function getStaticPaths() {
  const all = await published();
  return all.map((e, i) => ({ params: { slug: e.id }, props: { entry: e, newer: all[i - 1], older: all[i + 1] } }));
}
const { entry, newer } = Astro.props;
const d = entry.data;
const isHtml = d.format === 'html';
const { Content } = isHtml ? { Content: null } : await render(entry);
const url = `${SITE.url}/fishing-reports/${entry.id}`;
const ogImg = d.image ? new URL(media(d.image.src)?.at(1500) ?? '/', SITE.url).href : undefined;
// New Markdown articles (no original Squarespace head): full SEO/GEO head — BlogPosting + BreadcrumbList,
// reusing the site's LocalBusiness entity (@id https://fish-cabo.com/#business). Imported articles keep their original head.
const ogMedia = d.image ? media(d.image.src) : null;
const ogW = ogMedia ? Math.min(ogMedia.width, 1500) : undefined;
const ogH = ogMedia && ogW ? Math.round((ogMedia.height * ogW) / ogMedia.width) : undefined;
const seoT = d.seoTitle || d.title;
const q = (x: string) => x.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting', '@id': `${url}#article`, headline: d.title, description: d.description,
      ...(ogImg ? { image: { '@type': 'ImageObject', url: ogImg, width: ogW, height: ogH, ...(d.caption ? { caption: d.caption } : {}) } } : {}),
      datePublished: d.date.toISOString().slice(0, 10), dateModified: (d.updated ?? d.date).toISOString().slice(0, 10),
      author: { '@id': `${SITE.url}/#business` }, publisher: { '@id': `${SITE.url}/#business` },
      mainEntityOfPage: { '@type': 'WebPage', '@id': url }, inLanguage: 'en', articleSection: 'Fishing Reports',
      ...(d.tags.length ? { keywords: d.tags.join(', ') } : {}),
    },
    {
      '@type': 'BreadcrumbList', itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Fishing Reports', item: `${SITE.url}/fishing-reports` },
        { '@type': 'ListItem', position: 3, name: d.title, item: url },
      ],
    },
  ],
};
const head = d.originalHead ?? [
  `<title>${q(seoT)}</title>`, `<meta name="description" content="${q(d.description)}"/>`, `<link rel="canonical" href="${url}"/>`,
  `<meta property="og:site_name" content="EXOTIC FISH CABO"/>`, `<meta property="og:title" content="${q(seoT)}"/>`, `<meta property="og:description" content="${q(d.description)}"/>`,
  `<meta property="og:type" content="article"/>`, `<meta property="og:url" content="${url}"/>`, `<meta property="og:locale" content="en_US"/>`,
  ...(ogImg ? [`<meta property="og:image" content="${ogImg}"/>`, `<meta property="og:image:width" content="${ogW}"/>`, `<meta property="og:image:height" content="${ogH}"/>`, ...(d.image?.alt ? [`<meta property="og:image:alt" content="${q(d.image.alt)}"/>`] : [])] : []),
  `<meta property="article:published_time" content="${d.date.toISOString().slice(0, 10)}"/>`, `<meta property="article:section" content="Fishing Reports"/>`,
  `<meta name="twitter:card" content="summary_large_image"/>`, `<meta name="twitter:title" content="${q(seoT)}"/>`, `<meta name="twitter:description" content="${q(d.description)}"/>`,
  ...(ogImg ? [`<meta name="twitter:image" content="${ogImg}"/>`] : []),
  `<script type="application/ld+json">${JSON.stringify(ld)}</script>`,
];
const mdy = d.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<Base original={{ lang: 'en-US', head, bodyLd: [] }} solidHeader>
  <section class="section bg-white o-first">
    <div class="container o-flow">
      {isHtml
        ? <div class="rich o-html article" set:html={pictures(demoteBodyH1Keep(entry.body || ''), '(min-width: 1040px) 960px, 92vw')} />
        : <div class="rich o-html article"><article>
            <h1>{d.title}</h1>
            {d.category && <a href={catUrl(d.category)}>{d.category}</a>}
            <time datetime={d.date.toISOString().slice(0, 10)}>{mdy}</time> Written by <a href="/fishing-reports">{d.author}</a>
            {d.image && (d.caption || d.imageTitle
              ? <figure class="art-figure"><Fragment set:html={pictures(`<img alt="${q(d.image.alt)}" data-path="${d.image.src}"/>`, '(min-width: 1040px) 960px, 92vw').replace('<img alt=', d.imageTitle ? `<img title="${q(d.imageTitle)}" alt=` : '<img alt=')} />{d.caption && <figcaption>{d.caption}</figcaption>}</figure>
              : <Fragment set:html={pictures(`<img alt="${d.image.alt}" data-path="${d.image.src}"/>`, '(min-width: 1040px) 960px, 92vw')} />)}
            <Content />
            {d.tags.map((t) => <a href={tagUrl(t)} rel="tag">{t}</a>)}
          </article>
          {newer && <section><a href={`/fishing-reports/${newer.id}`}>Next <h2>{newer.data.title}</h2></a></section>}
        </div>}
    </div>
  </section>
</Base>
<style is:global>
  .article > article > h2.as-h1 { font-size: clamp(26px, 2vw + 14px, 48px); max-width: 30ch; }
  .article > article > h1 { font-size: clamp(34px, 3vw + 14px, 72px); max-width: 26ch; }
  .article > article > a[href*='/category/'] { display: inline-block; margin: 8px 12px 18px 0; padding: 6px 14px; border-radius: 999px; background: var(--orange); color: var(--ink); font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; }
  .article > article a[href*='author='] { display: inline-block; padding: 8px 4px; min-height: 24px; }
  /* article photos: never wider than ~960px on desktop (sharp at their resolution), centred, whole */
  .article picture { display: block; max-width: 960px; margin-inline: auto !important; }
  .article picture img { width: 100%; height: auto; }
  .article .art-figure { margin: 24px auto 32px; max-width: 960px; }
  .article .art-figure figcaption { margin-top: 10px; font-size: 14px; color: var(--muted); text-align: center; }
</style>
