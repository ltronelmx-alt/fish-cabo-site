---
// FISHING CHARTERS — ORIGINAL content/SEO verbatim (src/data/original/fishing-charters.json); design only here.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Rich from '../components/Rich.astro';
import OImg from '../components/OImg.astro';
import OBtn from '../components/OBtn.astro';
import { PAGES } from '../lib/original';

const P = PAGES['fishing-charters'];
const [s0, s1, s2, s3] = P.sections;
const b1 = s1.blocks; // text(main) · text(h2 grounds) · img(amberjack) · text(grounds) · img · img · btn · btn
const t = b1.filter((b) => b.kind === 'text');
const im = b1.filter((b) => b.kind === 'img');
const bt = b1.filter((b) => b.kind === 'button');
---
<Base original={P}>
  <Hero position="50% 35%" image={{ src: s0.bg!.path, alt: s0.bg!.alt }}>
    {s0.blocks.map((b) => <div set:html={b.html} />)}
  </Hero>

  <!-- Section 1: blocks in ORIGINAL DOM order; positions set with CSS grid -->
  <section class="section bg-white">
    <div class="container s1grid">
      {s1.blocks.slice().sort((x, y) => (x as any).dom - (y as any).dom).map((bl) => {
        const k = (bl as any).dom;
        const cls = ['main', 'amber', 'grounds', 'gh2', 'img1', 'img2', 'btnA', 'btnB'][k];
        return bl.kind === 'text' ? <Rich html={bl.html!} class={`${cls} reveal`} />
          : bl.kind === 'img' ? <OImg block={bl} class={`${cls} ratio-3x2 reveal`} sizes="(min-width: 900px) 46vw, 92vw" />
          : <div class={cls}><OBtn block={bl} /></div>;
      })}
    </div>
  </section>

  <section class="banner dark">
    {s2.bg && <OImg block={{ path: s2.bg.path, alt: s2.bg.alt }} class="banner-img" sizes="100vw" />}
    <div class="container">{s2.blocks.map((b) => <div class="reveal" set:html={b.html} />)}</div>
  </section>

  <section class="section bg-sand">
    <div class="container grid cols-2">
      {s3.blocks.map((b) => <div class="card review reveal" set:html={b.html} />)}
    </div>
  </section>
</Base>

<style>
  .s1grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(32px, 6vw, 96px); row-gap: clamp(32px, 4vw, 56px); align-items: start; }
  .s1grid :global(.main) { grid-column: 1 / -1; grid-row: 1; }
  .s1grid :global(.main ul) { grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); }
  .s1grid :global(.gh2) { grid-column: 1; grid-row: 2; align-self: center; padding-top: var(--section-pad); }
  .s1grid :global(.amber) { grid-column: 2; grid-row: 2; margin-top: var(--section-pad); }
  .s1grid :global(.grounds) { grid-column: 1 / -1; grid-row: 3; }
  .s1grid :global(.img1) { grid-column: 1; grid-row: 4; }
  .s1grid :global(.img2) { grid-column: 2; grid-row: 4; }
  .s1grid :global(.btnB) { grid-column: 1; grid-row: 5; justify-self: center; }
  .s1grid :global(.btnA) { grid-column: 2; grid-row: 5; justify-self: center; }
  /* both buttons: centred under their photo, same width */
  .s1grid :global(:is(.btnA, .btnB) a) { width: 300px; }
  @media (max-width: 640px) { .s1grid :global(:is(.btnA, .btnB) a) { width: 100%; } }
  @media (max-width: 900px) { .s1grid { grid-template-columns: 1fr; } .s1grid > :global(*) { grid-column: 1 !important; grid-row: auto !important; justify-self: stretch !important; }
    .s1grid :global(.main) { order: 1; } .s1grid :global(.gh2) { order: 2; } .s1grid :global(.amber) { order: 3; } .s1grid :global(.grounds) { order: 4; } .s1grid :global(.img1) { order: 5; } .s1grid :global(.img2) { order: 7; } .s1grid :global(.btnB) { order: 6; } .s1grid :global(.btnA) { order: 8; } .s1grid :global(.gh2) { padding-top: 0; } .s1grid :global(.amber) { margin-top: 0; } }
  .banner { position: relative; isolation: isolate; overflow: hidden; display: grid; grid-template: 1fr / 1fr; text-align: center; background: var(--ink); }
  .banner > :global(.banner-img), .banner::after, .banner > .container { grid-area: 1 / 1; }
  .banner :global(.banner-img) { position: relative; z-index: -2; border-radius: 0; box-shadow: none; }
  .banner :global(.banner-img img) { width: 100%; height: auto; }
  .banner::after { content: ''; position: relative; z-index: -1; background: linear-gradient(to top, rgb(0 0 0 / 0.75), rgb(0 0 0 / 0.35)); }
  .banner > .container { align-self: center; padding-block: 48px; }
  @media (max-width: 760px) { .banner { grid-template: auto auto / 1fr; } .banner > .container { grid-row: 2; } .banner::after { display: none; } }
  .banner :global(h3) { color: var(--white); font-size: clamp(28px, 2.6vw + 14px, 60px); line-height: 1.02; letter-spacing: -0.03em; max-width: 20ch; margin: 0 auto; }
  .review { display: flex; flex-direction: column; text-align: left; background: var(--white) !important; }
  .review :global(p:first-child) { color: var(--orange); letter-spacing: 0.2em; }
  .review :global(p:nth-child(2)) { font-size: var(--fs-lead); line-height: 1.6; color: var(--ink); }
  .review :global(p:last-child) { margin-top: auto; padding-top: 16px; color: var(--muted); letter-spacing: 0.06em; text-transform: uppercase; font-size: 0.9em; }
</style>
