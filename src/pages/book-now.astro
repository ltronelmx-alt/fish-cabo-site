---
// /book-now — online booking (Cloudflare Workers + D1).
// Pricing policy (owner, 2026-11-08): NO price grid and NO deposits in this page's HTML or JS. The customer picks boat →
// duration → date, then SHOW MY PRICE fetches ONE quote from the server. Contact details are asked only after that.
// No Product/Offer/availability schema on purpose (prices are only shown per request; avoids misleading snippets).
import Base from '../layouts/Base.astro';
import catalogue from '../data/boats.json';
import { SITE } from '../data/site';
import { media } from '../lib/media';

const title = 'Book a Fishing Charter in San Jose del Cabo | Exotic Fish Cabo';
const description = 'Book your private fishing charter from Puerto Los Cabos Marina online: choose your boat, date and 6 or 8 hour trip, and pay the deposit by card or Wise.';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY || '0x4AAAAAAFyrH2-R96GEy7AN'; // real key; replaced by the test key off fish-cabo.com (public/js/efc-turnstile.js)
// public data only: number, size, capacity, photo (prices/deposits are server-side, worker/booking/pricing.ts)
const boats = catalogue.boats.map((b) => ({ id: b.id, number: b.number, name: b.name, capacity: b.capacity, img: media(b.image.path)?.at(480) ?? '', alt: b.image.alt }));
const isProd = import.meta.env.PUBLIC_SITE_ENV === 'production';
const wa = SITE.whatsapp.replace(/\D/g, '');
---
<Base title={title} description={description} solidHeader>
  <Fragment slot="head">
    <link rel="canonical" href={`${SITE.url}/book-now`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${SITE.url}/book-now`} />
    <meta property="og:type" content="website" />
  </Fragment>

  <section class="section bg-sand bk-top">
    <div class="container">
      <h1 class="bk-h1">Book Your San Jose del Cabo Fishing Charter</h1>
      <p class="bk-lead">Choose your boat, your trip and your fishing date, then tap SHOW MY PRICE. Every charter is private and leaves from Puerto Los Cabos Marina in San José del Cabo.</p>
      <ul class="bk-facts">
        <li><b>One private trip per boat per day</b> — the boat is yours.</li>
        <li><b>See your price before giving any personal details.</b> A deposit secures your date; the balance is paid in cash on the fishing day.</li>
        <li><b>Deposit by card</b> (Stripe, +6% processing fee) <b>or Wise</b> (no fee).</li>
        <li><b>Book at least 24 hours</b> before your trip. Last minute? <a href={`https://wa.me/${wa}`}>WhatsApp us</a>.</li>
      </ul>
    </div>
  </section>

  <section class="section bg-white bk-sec">
    <div class="container">
      <form id="bk" class="bk" novalidate data-wa={wa}>
        <noscript><p class="bk-note">Online booking needs JavaScript. You can also <a href="/contact">contact us</a> or WhatsApp +52 624 122 3506.</p></noscript>
        <div class="bk-step">
          <h2><span>1</span> Choose your boat</h2>
          <div class="bk-boats" role="radiogroup" aria-label="Boat">
            {boats.map((b) => (
              <label class="bk-boat" data-id={b.id}>
                <input type="radio" name="boat" value={b.id} required />
                {b.img && <img src={b.img} alt={b.alt} loading="lazy" decoding="async" width="320" height="200" />}
                <span class="bk-bn">#{b.number} · {b.name}</span>
                <span class="bk-bm">Up to {b.capacity} {b.capacity === 1 ? 'person' : 'people'}</span>
                <span class="bk-bp" data-durs></span>
              </label>
            ))}
          </div>
        </div>

        <div class="bk-step" id="s-dur" hidden>
          <h2><span>2</span> Trip duration</h2>
          <fieldset class="bk-dur"><legend>Trip duration * <small>(required)</small></legend>
            <label data-h="6"><input type="radio" name="duration" value="6" required /> <span><b>6-Hour Fishing Trip</b> (3/4 day)</span></label>
            <label data-h="8"><input type="radio" name="duration" value="8" /> <span><b>8-Hour Fishing Trip</b> (full day)</span></label>
          </fieldset>
          <p class="bk-hint" id="only6" hidden>Boat #1 offers 6-hour trips only.</p>
        </div>

        <div class="bk-step" id="s-date" hidden>
          <h2><span>3</span> Fishing date</h2>
          <div class="bk-cal" aria-live="polite">
            <div class="bk-calhead"><button type="button" class="bk-nav" data-m="-1" aria-label="Previous month">‹</button><b id="cal-month"></b><button type="button" class="bk-nav" data-m="1" aria-label="Next month">›</button></div>
            <div class="bk-grid" id="cal-grid"></div>
            <p class="bk-legend"><i class="l-av"></i>Available <i class="l-bk"></i>Booked <i class="l-na"></i>Not bookable online</p>
          </div>
          <input type="hidden" name="date" />
          <div class="bk-alert" id="booked" hidden>
            <p><strong>This boat already has a booking on your selected date. A second trip may be possible upon request. Please contact us to check availability.</strong></p>
            <a class="btn btn-primary no-arrow" id="req" href={`https://wa.me/${wa}`} target="_blank" rel="noopener" data-track="request_availability_whatsapp">REQUEST AVAILABILITY</a>
            <small>Opens WhatsApp with your request ready — just press Send.</small>
          </div>
        </div>

        <div class="bk-step" id="s-price" hidden>
          <h2><span>4</span> Your price</h2>
          <button type="button" class="btn btn-primary no-arrow" id="show-price">SHOW MY PRICE</button>
          <div class="bk-quote" id="quote" hidden aria-live="polite"></div>
          <p class="bk-msg" id="qmsg" role="status" aria-live="polite"></p>
        </div>

        <div class="bk-step" id="s-details" hidden>
          <h2><span>5</span> Your details</h2>
          <div class="bk-two">
            <label>First Name *<input name="fname" autocomplete="given-name" required maxlength="80" /></label>
            <label>Last Name *<input name="lname" autocomplete="family-name" required maxlength="80" /></label>
          </div>
          <div class="bk-two">
            <label>Email *<input name="email" type="email" autocomplete="email" required maxlength="120" /></label>
            <label>Phone *<input name="phone" type="tel" autocomplete="tel" required maxlength="40" /></label>
          </div>
          <label>People aboard *<select name="people" required><option value="">Select an option</option></select></label>
          <label>Special requests <small>(optional)</small><textarea name="message" rows="3" maxlength="5000" placeholder="Target species, children aboard, anything we should know…"></textarea></label>
          <button type="button" class="btn btn-primary no-arrow" id="to-pay">REVIEW &amp; PAY DEPOSIT</button>
          <p class="bk-msg" id="dmsg" role="status" aria-live="polite"></p>
        </div>

        <div class="bk-step" id="s-pay" hidden>
          <h2><span>6</span> Review and pay your deposit</h2>
          <fieldset class="bk-payopts"><legend>Payment method *</legend>
            <label><input type="radio" name="payment" value="stripe" required /> <span><b>Card via Stripe (+6% processing fee)</b></span></label>
            <label><input type="radio" name="payment" value="wise" /> <span><b>Wise (no processing fee)</b> — your date is held 24 hours while we verify your transfer</span></label>
          </fieldset>
          <div class="bk-sum" id="sum"></div>
          <div class="bk-cond">
            <p><b>Booking and cancellation conditions</b></p>
            <ul>
              <li>Your booking is confirmed by email once your deposit payment has been verified.</li>
              <li>The remaining balance is paid in cash on the fishing day (there is no ATM at the marina).</li>
              <li>Deposits are not refunded if you cancel or do not show up. If bad weather or a port closure prevents the trip, it is rescheduled; if rescheduling is not possible, a voucher is issued for a future trip.</li>
            </ul>
          </div>
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
          <div class="cf-turnstile" data-sitekey={siteKey}></div>
          <p class="bk-legal">By completing your booking, you agree to our <a href="/terms-conditions" target="_blank" rel="noopener">Terms &amp; Conditions</a> and acknowledge our <a href="/privacy-policy" target="_blank" rel="noopener">Privacy Policy</a>.</p>
          <button class="btn btn-primary no-arrow bk-go" type="submit">PAY DEPOSIT &amp; BOOK</button>
          <p class="bk-msg" id="pmsg" role="status" aria-live="polite"></p>
          {!isProd && <p class="bk-test">Staging: test mode — no real payment is taken.</p>}
        </div>
      </form>
    </div>
  </section>
</Base>
<script is:inline src="/js/efc-turnstile.js" defer></script>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>
<script>
  type B = { id: string; number: number; sizeFt: number; capacity: number; durations: number[]; bookable: boolean };
  type Q = { boat: string; hours: number; date: string; total: number; cardFeePct: number };
  type S = { total: number; deposit: number; balance: number; cardFeePct: number; cardFeeCents: number; cardChargeCents: number; wiseChargeCents: number };
  const f = document.getElementById('bk') as HTMLFormElement;
  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector(s) as T;
  const show = (id: string, on: boolean) => { const el = document.getElementById(id); if (el) el.hidden = !on; };
  const money = (n: number) => '$' + n.toLocaleString('en-US') + ' USD';
  const cents = (c: number) => '$' + (c / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' USD';
  const longDate = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
  const POST = (url: string, body: unknown) => fetch(url, { method: 'POST', headers: { 'content-type': 'application/json', 'x-efc-quote': '1' }, body: JSON.stringify(body) }).then(async (r) => [r.status, await r.json().catch(() => ({}))] as const);
  let boats: B[] = [], today = '', month = '', days: Record<string, string> = {};
  let quote: Q | null = null, sum: S | null = null;
  const q = new URLSearchParams(location.search);
  const boat = () => boats.find((b) => b.id === (f.elements.namedItem('boat') as RadioNodeList).value);
  const val = (n: string) => ((f.elements.namedItem(n) as RadioNodeList | HTMLInputElement)?.value || '');
  const dur = () => Number(val('duration')) || 0;

  /** Prefilled WhatsApp message (free click-to-chat; the customer presses Send). */
  function waUrl() {
    const b = boat(); const lines = ['Hello Exotic Fish Cabo, I would like to request availability:'];
    if (b) lines.push(`Boat #${b.number}`);
    if (val('date')) lines.push(`Date: ${longDate(val('date'))}`);
    if (dur()) lines.push(`Duration: ${dur()} hours`);
    const name = [val('fname'), val('lname')].filter(Boolean).join(' ');
    if (name) lines.push(`Name: ${name}`);
    if (val('email')) lines.push(`Email: ${val('email')}`);
    if (val('phone')) lines.push(`Phone: ${val('phone')}`);
    if (val('people')) lines.push(`People aboard: ${val('people')}`);
    if (val('message')) lines.push(`Special requests: ${val('message')}`);
    return `https://wa.me/${f.dataset.wa}?text=${encodeURIComponent(lines.join('\n'))}`;
  }
  /** Any change of boat, duration or date invalidates the quote and everything after it. */
  function resetQuote() {
    quote = null; sum = null;
    show('quote', false); show('s-details', false); show('s-pay', false);
    $('#qmsg').textContent = '';
    const ready = !!boat() && !!dur() && days[val('date')] === 'available';
    show('s-price', ready);
  }

  async function init() {
    try {
      const r = await fetch('/api/booking/boats'); const j = await r.json();
      if (!j.ok) throw 0;
      boats = j.boats; today = j.today; month = today.slice(0, 7);
    } catch {
      const m = document.createElement('p'); m.className = 'bk-msg';
      m.innerHTML = 'Online booking is not available right now. Please <a href="/contact">contact us</a> or WhatsApp +52 624 122 3506.';
      f.prepend(m); return;
    }
    f.querySelectorAll<HTMLElement>('.bk-boat').forEach((el) => {
      const b = boats.find((x) => x.id === el.dataset.id);
      const p = el.querySelector('[data-durs]')!;
      if (!b || !b.bookable) { el.classList.add('off'); (el.querySelector('input') as HTMLInputElement).disabled = true; p.textContent = 'Not available online'; return; }
      p.textContent = b.durations.length === 2 ? '6-hour or 8-hour trips' : `${b.durations[0]}-hour trips only`;
    });
    const pre = q.get('boat');
    if (pre) { const r = f.querySelector<HTMLInputElement>(`input[name=boat][value="${CSS.escape(pre)}"]`); if (r && !r.disabled) { r.checked = true; pickBoat(); r.closest('.bk-boat')?.scrollIntoView({ block: 'center' }); } }
  }

  function pickBoat() {
    const b = boat(); if (!b) return;
    show('s-dur', true);
    // only the durations this boat offers (Boat #1 = 6 hours only)
    f.querySelectorAll<HTMLElement>('.bk-dur label').forEach((l) => {
      const h = Number(l.dataset.h); const ok = b.durations.includes(h); l.hidden = !ok;
      const i = l.querySelector('input') as HTMLInputElement; i.disabled = !ok; if (!ok) i.checked = false;
    });
    if (b.durations.length === 1) (f.querySelector(`input[name=duration][value="${b.durations[0]}"]`) as HTMLInputElement).checked = true;
    show('only6', b.durations.length === 1 && b.durations[0] === 6);
    const sel = $('select[name=people]') as HTMLSelectElement; const cur = sel.value;
    sel.innerHTML = '<option value="">Select an option</option>' + Array.from({ length: Math.min(b.capacity, 10) }, (_, i) => `<option value="${i + 1}">${i + 1} ${i ? 'people' : 'person'}</option>`).join('');
    if (+cur <= b.capacity) sel.value = cur;
    (f.elements.namedItem('date') as HTMLInputElement).value = ''; show('booked', false);
    resetQuote(); onDuration();
  }
  function onDuration() {
    show('s-date', !!boat() && !!dur());
    if (boat() && dur()) loadMonth();
    resetQuote();
  }
  async function loadMonth() {
    const b = boat(); if (!b) return;
    const grid = document.getElementById('cal-grid')!; grid.setAttribute('aria-busy', 'true');
    const j = await fetch(`/api/booking/availability?boat=${b.id}&month=${month}`).then((r) => r.json()).catch(() => ({ ok: false }));
    days = j.ok ? j.days : {};
    const [y, m] = month.split('-').map(Number);
    document.getElementById('cal-month')!.textContent = new Date(Date.UTC(y, m - 1, 1)).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
    const lead = (new Date(Date.UTC(y, m - 1, 1)).getUTCDay() + 6) % 7;
    const labels: Record<string, string> = { available: 'available', booked: 'already booked', pending: 'already booked', blocked: 'not available', too_soon: 'less than 24 h away — contact us', past: 'past', closed: 'not open yet' };
    grid.innerHTML = ['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su'].map((d) => `<span class="dow">${d}</span>`).join('') + '<span></span>'.repeat(lead) +
      Object.entries(days).map(([d, s]) => `<button type="button" class="day s-${s}${d === val('date') ? ' sel' : ''}" data-d="${d}" ${['available', 'booked', 'pending'].includes(s) ? '' : 'disabled'} aria-label="${new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'UTC' })}: ${labels[s]}">${+d.slice(8)}</button>`).join('');
    grid.removeAttribute('aria-busy');
    (f.querySelector('.bk-nav[data-m="-1"]') as HTMLButtonElement).disabled = month <= today.slice(0, 7);
  }
  function pickDay(d: string) {
    (f.elements.namedItem('date') as HTMLInputElement).value = d;
    f.querySelectorAll('.day.sel').forEach((x) => x.classList.remove('sel'));
    f.querySelector(`.day[data-d="${d}"]`)?.classList.add('sel');
    const taken = days[d] === 'booked' || days[d] === 'pending';
    show('booked', taken); ($('#req') as HTMLAnchorElement).href = waUrl();
    resetQuote();
    if (taken) document.getElementById('booked')!.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    else document.getElementById('s-price')!.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  }

  async function showPrice() {
    const b = boat(), h = dur(), d = val('date'); if (!b || !h || !d) return;
    const btn = $('#show-price') as HTMLButtonElement; btn.disabled = true; $('#qmsg').textContent = 'Checking your price…';
    const [st, j] = await POST('/api/booking/quote', { boat: b.id, hours: h, date: d }).catch(() => [0, {}] as const);
    btn.disabled = false;
    // the selection may have changed while waiting: ignore a stale answer
    if (b !== boat() || h !== dur() || d !== val('date')) return;
    if (!j.ok) {
      $('#qmsg').textContent = j.error || 'Sorry, the price could not be loaded. Please try again or contact us on WhatsApp.';
      if (j.code === 'BOOKED') { await loadMonth(); pickDay(d); }
      return;
    }
    quote = j as Q; $('#qmsg').textContent = '';
    $('#quote').innerHTML = `<p class="bk-qline">Boat #${b.number} · ${h}-hour trip · ${longDate(d)}</p>
      <p class="bk-total">Total charter price: <b>${money(quote.total)}</b></p>
      <p class="bk-qnote">Private charter price for the boat. A deposit secures your date and the remaining balance is paid in cash on the fishing day. Card payments carry a ${quote.cardFeePct}% processing fee; Wise has no fee. You will see every amount before you pay.</p>
      <div class="bk-qbtns"><button type="button" class="btn btn-primary no-arrow" id="continue">CONTINUE TO BOOKING</button><button type="button" class="btn no-arrow" id="change">CHANGE MY SELECTION</button></div>`;
    show('quote', true);
  }

  function details() { show('s-details', true); document.getElementById('s-details')!.scrollIntoView({ block: 'start', behavior: 'smooth' }); }

  async function toPay() {
    const need = ['fname', 'lname', 'email', 'phone', 'people'];
    for (const n of need) { const el = f.elements.namedItem(n) as HTMLInputElement; if (!el.checkValidity()) { el.reportValidity(); $('#dmsg').textContent = 'Please complete all required fields.'; return; } }
    if (!quote) return;
    $('#dmsg').textContent = '';
    const [, j] = await POST('/api/booking/summary', { boat: quote.boat, hours: quote.hours }).catch(() => [0, {}] as const);
    if (!j.ok) { $('#dmsg').textContent = j.error || 'Please try again.'; return; }
    sum = j as S; summary(); show('s-pay', true);
    document.getElementById('s-pay')!.scrollIntoView({ block: 'start', behavior: 'smooth' });
  }
  function summary() {
    if (!quote || !sum) return;
    const b = boat()!, pay = val('payment');
    const fee = pay === 'stripe' ? `<dt>Card processing fee (${sum.cardFeePct}% of the deposit)</dt><dd>${cents(sum.cardFeeCents)}</dd>` : pay === 'wise' ? '<dt>Processing fee</dt><dd>None (Wise)</dd>' : '';
    const now = pay === 'stripe' ? cents(sum.cardChargeCents) : pay === 'wise' ? cents(sum.wiseChargeCents) : 'Choose a payment method';
    document.getElementById('sum')!.innerHTML = `<dl><dt>Boat</dt><dd>#${b.number} (${b.sizeFt} ft)</dd><dt>Date</dt><dd>${longDate(quote.date)}</dd><dt>Trip duration</dt><dd>${quote.hours} hours</dd>
      <dt>Total charter price</dt><dd>${money(sum.total)}</dd><dt>Deposit</dt><dd>${money(sum.deposit)}</dd>${fee}
      <dt>Total charged now</dt><dd class="bk-now">${now}</dd><dt>Remaining balance (cash on the fishing day)</dt><dd>${money(sum.balance)}</dd>
      <dt>Payment method</dt><dd>${pay === 'stripe' ? 'Card via Stripe' : pay === 'wise' ? 'Wise' : '—'}</dd></dl>`;
  }

  f.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name === 'boat') pickBoat();
    if (t.name === 'duration') onDuration();
    if (t.name === 'payment') summary();
    if (['fname', 'lname', 'email', 'phone', 'people', 'message'].includes(t.name)) ($('#req') as HTMLAnchorElement).href = waUrl();
  });
  f.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!t) return;
    if (t.classList.contains('day')) pickDay(t.dataset.d!);
    if (t.classList.contains('bk-nav')) {
      const [y, m] = month.split('-').map(Number);
      month = new Date(Date.UTC(y, m - 1 + Number(t.dataset.m), 1)).toISOString().slice(0, 7); loadMonth();
    }
    if (t.id === 'show-price') showPrice();
    if (t.id === 'continue') details();
    if (t.id === 'change') { resetQuote(); f.scrollIntoView({ block: 'start', behavior: 'smooth' }); }
    if (t.id === 'to-pay') toPay();
  });
  f.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = $('#pmsg');
    if (!quote || !sum) { msg.textContent = 'Please check your price first.'; return; }
    if (!val('payment')) { msg.textContent = 'Please choose a payment method.'; return; }
    if (!f.checkValidity()) { f.reportValidity(); msg.textContent = 'Please complete all required fields.'; return; }
    const btn = $('.bk-go') as HTMLButtonElement; btn.disabled = true; msg.textContent = 'Reserving your date…';
    const fd = new FormData(f); fd.set('lang', (navigator.language || 'en').slice(0, 2));
    try {
      const r = await fetch('/api/booking/reserve', { method: 'POST', body: fd });
      const j = await r.json().catch(() => ({}));
      if (j.ok && j.redirect) { msg.textContent = 'Redirecting…'; navigator.sendBeacon?.('/api/event', new Blob([JSON.stringify({ event: 'booking_started_' + val('payment'), page: location.pathname })], { type: 'application/json' })); location.href = j.redirect; return; }
      if (j.code === 'BOOKED') { await loadMonth(); pickDay(val('date')); }
      msg.textContent = j.error || 'Sorry, something went wrong. Please try again or contact us on WhatsApp.';
      (window as any).turnstile?.reset?.();
    } catch { msg.textContent = 'Network error. Please try again.'; }
    btn.disabled = false;
  });
  init();
</script>
<style is:global>
  .bk-top { padding-block: clamp(110px, 12vw, 160px) clamp(32px, 4vw, 56px); }
  .bk-h1 { font-family: var(--font-head); font-size: clamp(30px, 4vw, 54px); line-height: 1.05; margin: 0 0 16px; max-width: 18ch; }
  .bk-lead { font-size: var(--fs-lead); max-width: 60ch; margin: 0 0 20px; }
  .bk-facts { margin: 0; padding-left: 1.1em; display: grid; gap: 6px; font-size: var(--fs-p); }
  .bk-sec { padding-top: clamp(32px, 4vw, 56px); }
  .bk { display: grid; gap: clamp(28px, 3vw, 44px); max-width: 980px; margin-inline: auto; }
  .bk-step h2 { font-family: var(--font-head); font-size: clamp(20px, 2vw, 28px); margin: 0 0 16px; display: flex; gap: 12px; align-items: center; }
  .bk-step h2 span { display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--orange); color: #fff; font-size: 16px; flex: none; }
  .bk-boats { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr)); gap: 14px; }
  .bk-boat { position: relative; display: grid; gap: 4px; padding: 10px 10px 14px; border: 2px solid var(--line); border-radius: var(--radius-sm); background: var(--white); cursor: pointer; font-family: var(--font-ui); transition: border-color .15s, box-shadow .15s; }
  .bk-boat:hover { border-color: #f5c08a; }
  .bk-boat:has(input:checked) { border-color: var(--orange); box-shadow: 0 0 0 3px rgb(251 119 4 / .18); }
  .bk-boat:has(input:focus-visible) { outline: 3px solid var(--ink); outline-offset: 2px; }
  .bk-boat input { position: absolute; opacity: 0; pointer-events: none; }
  .bk-boat img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 6px; margin-bottom: 6px; }
