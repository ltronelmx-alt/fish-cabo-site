---
import { BOOKING_OPEN, BOOKING_CARD } from '../lib/launch';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Chat from '../components/Chat.astro';
import { SITE } from '../data/site';
import { media } from '../lib/media';
import { fixHead, heroFallback } from '../lib/seo-fixes';

interface Props {
  // SEO: either the ORIGINAL Squarespace head tags (verbatim) or a minimal title/description (404 only).
  original?: { lang: string; head: string[]; bodyLd: string[] };
  title?: string;
  description?: string;
  solidHeader?: boolean; // page without a photo hero: header is solid from the start
  canonical?: string; // override (paginated archive only)
}
const { original, title, description, solidHeader = false, canonical } = Astro.props;
const head = original ? fixHead(original.head, { canonical, fallback: heroFallback(original) }) : [];
const bodyLd = original ? fixHead(original.bodyLd) : [];
// Safety: every build is "staging" (noindex) unless SITE_ENV=production is set explicitly.
const isProd = import.meta.env.PUBLIC_SITE_ENV === 'production';
const beacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---
<!doctype html>
<html lang={original?.lang ?? 'en-US'} class:list={[solidHeader && 'solid-header']} data-booking={BOOKING_OPEN ? 'open' : 'closed'} data-card={BOOKING_CARD ? 'on' : 'off'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {original ? <Fragment set:html={head.join('\n')} /> : <><title>{title}</title><meta name="description" content={description} /></>}
    {!isProd && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preload" href="/fonts/syne-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/syne-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#000000" />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Chat />
    <script is:inline>
      // Motion layer (smooth scroll + fades) loads only after the page has fully loaded: zero impact on first paint / LCP.
      (function () {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) { document.documentElement.classList.add('efc-live'); return; }
        function go() {
          document.documentElement.classList.add('efc-live');
          var l = document.createElement('link'); l.rel = 'stylesheet'; l.href = '/css/efc-motion.css'; document.head.appendChild(l);
          var a = document.createElement('script'); a.src = '/js/lenis.min.js';
          a.onload = a.onerror = function () { var b = document.createElement('script'); b.src = '/js/efc-motion.js'; document.body.appendChild(b); };
          document.body.appendChild(a);
        }
        // Loaded on the visitor's first gesture: nothing competes with the first render.
        var done = false, ev = ['pointerdown', 'wheel', 'touchstart', 'keydown'];
        function once(e) { if (done || (e && e.isTrusted === false)) return; done = true; ev.forEach(function (e) { removeEventListener(e, once, true); }); go(); }
        ev.forEach(function (e) { addEventListener(e, once, { capture: true, passive: true }); });
        // (no timer: visitors who never touch the page do not need the motion layer)
      })();
    </script>
    {bodyLd.length > 0 && <Fragment set:html={bodyLd.join('\n')} />}
    {beacon && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: beacon })}></script>}
    <script>
      // Commercial-action tracking: records clicks only (never claims a booking was completed).
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-track]');
        if (!el) return;
        const body = JSON.stringify({ event: el.dataset.track, page: location.pathname, href: (el as HTMLAnchorElement).href || '' });
        navigator.sendBeacon?.('/api/event', new Blob([body], { type: 'application/json' }));
      });
    </script>
  </body>
</html>
